    },
    "scripts": {
     "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm --prefix ../packages/core run build && tsc && node -e \"const fs=require('fs'); ['dist/index.js','dist/http.js','dist/cli/index.js','dist/cli/create.js'].forEach((file)=>{ if (fs.existsSync(file)) fs.chmodSync(file, 0o755); });\"",
