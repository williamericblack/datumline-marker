    "repository": {
     "type": "git",
     "url": "git+https://github.com/molanojustin/smithsonian-mcp.git"
    },
    "scripts": {
     "bump:major": "npm version major && node -e \"const fs=require('fs'); const pkg=require('./package.json'); const toml=fs.readFileSync('pyproject.toml','utf8'); fs.writeFileSync('pyproject.toml', toml.replace(/^version\\s*=\\s*\\\"[^\\\"]+\\\"/m, 'version = \\\"'+pkg.version+'\\\"')); require('child_process').execSync('uv lock')\" && git add pyproject.toml uv.lock && git commit --amend --no-edit",
     "bump:minor": "npm version minor && node -e \"const fs=require('fs'); const pkg=require('./package.json'); const toml=fs.readFileSync('pyproject.toml','utf8'); fs.writeFileSync('pyproject.toml', toml.replace(/^version\\s*=\\s*\\\"[^\\\"]+\\\"/m, 'version = \\\"'+pkg.version+'\\\"')); require('child_process').execSync('uv lock')\" && git add pyproject.toml uv.lock && git commit --amend --no-edit",
     "bump:patch": "npm version patch && node -e \"const fs=require('fs'); const pkg=require('./package.json'); const toml=fs.readFileSync('pyproject.toml','utf8'); fs.writeFileSync('pyproject.toml', toml.replace(/^version\\s*=\\s*\\\"[^\\\"]+\\\"/m, 'version = \\\"'+pkg.version+'\\\"')); require('child_process').execSync('uv lock')\" && git add pyproject.toml uv.lock && git commit --amend --no-edit",
     "check-version": "node -e \"const pkg=require('./package.json'); const fs=require('fs'); const toml=fs.readFileSync('pyproject.toml','utf8'); const match=toml.match(/^version\\s*=\\s*\\\"([^\\\"]+)\\\"/m); if(!match||pkg.version!==match[1]){console.error('\u274c Version mismatch: package.json='+pkg.version+', pyproject.toml='+(match?match[1]:'not found')); process.exit(1);} console.log('\u2705 Versions match: '+pkg.version);\"",
     "postversion": "git push && git push --tags",
     "prepublishOnly": "npm run check-version && npm test",
     "preversion": "npm test",
     "release": "npm run check-version && npm test && npm publish && git push --follow-tags",
     "start": "node bin/smithsonian-mcp.js",
     "test": "node bin/smithsonian-mcp.js --test",
     "version": "git add -A ."
    },
    "version": "0.3.0"
   },
