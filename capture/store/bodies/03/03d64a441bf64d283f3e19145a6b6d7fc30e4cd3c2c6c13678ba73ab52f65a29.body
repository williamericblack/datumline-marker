    "mcpName": "io.github.imgly/codesign",
    "name": "@imgly/codesign-mcp",
    "peerDependencies": {
     "@cesdk/node-native": "1.80.0-nightly.20260728"
    },
    "peerDependenciesMeta": {
     "@cesdk/node-native": {
      "optional": true
     }
    },
    "publishConfig": {
     "access": "public"
    },
    "readmeFilename": "README.md",
    "repository": {
     "directory": "packages/codesign-mcp",
     "type": "git",
     "url": "git+https://github.com/imgly/imgly-codesign.git"
    },
    "scripts": {
     "build": "tsc --build tsconfig.src.json && shx chmod +x dist/cli.js",
     "bump:cesdk": "node --experimental-strip-types scripts/bump-cesdk.ts",
     "changelog:add": "node --experimental-strip-types scripts/changelog-add.ts",
     "changelog:collate": "node --experimental-strip-types scripts/changelog-collate.ts",
     "changelog:section": "node --experimental-strip-types scripts/changelog-section.ts",
     "check": "tsc --build tsconfig.src.json && tsc --build tsconfig.test.json && tsc -p tsconfig.scripts.json",
     "clean": "shx rm -rf dist *.tsbuildinfo",
     "dev:claude": "bash scripts/dev-claude.sh",
     "generate-assets": "node scripts/generate-inline-assets.mjs",
     "generate-auth-config": "node scripts/generate-auth-config.mjs",
     "generate-release-flags": "node scripts/generate-release-flags.mjs",
     "generate-spa-assets": "node scripts/generate-spa-assets.mjs",
     "generate-spa-assets:diagnostics": "node scripts/generate-spa-assets.mjs src/diagnostics/spa src/diagnostics/spa-assets.generated.ts",
     "generate-trial-license": "node scripts/generate-trial-license.mjs",
     "prebuild": "pnpm run refresh-assets",
     "precheck": "pnpm run refresh-assets",
     "prepare": "pnpm run build",
     "pretest": "pnpm run refresh-assets",
     "publish:beta": "node scripts/publish-beta.mjs",
     "refresh-assets": "pnpm run sync:cesdk-api && pnpm run generate-assets && pnpm run generate-spa-assets && pnpm run generate-spa-assets:diagnostics && pnpm run generate-trial-license && pnpm run generate-auth-config && pnpm run generate-release-flags",
     "sync:cesdk-api": "node --experimental-strip-types scripts/sync-cesdk-api.ts",
     "sync:cesdk-skills": "node --experimental-strip-types scripts/sync-cesdk-skills.ts",
     "test": "vitest --run",
     "test:bundle": "vitest --run --config vitest.bundle.config.ts"
    },
    "type": "module",
    "version": "0.1.11-next.20260729125002.g521a68a"
   },
