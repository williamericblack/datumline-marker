 "manifest": {
  "_id": "@jalipata/mcp-memory",
  "_rev": "14-2aef43b3dbb037897d07bc1daac55a89",
  "description": "Agnostic persistent memory server for AI tools via MCP. Knowledge graph stored in SQLite with FTS5 keyword search, multi-tenant by namespace.",
