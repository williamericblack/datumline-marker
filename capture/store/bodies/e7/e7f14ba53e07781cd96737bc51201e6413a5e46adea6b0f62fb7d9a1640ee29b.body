    "mcpName": "io.github.cyanheads/congressgov-mcp-server",
    "name": "@cyanheads/congressgov-mcp-server",
    "packageManager": "bun@1.3.14",
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/cyanheads/congressgov-mcp-server.git"
    },
    "scripts": {
     "audit:refresh": "rm -f bun.lock && bun install && bun audit",
     "build": "bun scripts/build.ts",
     "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/congressgov-mcp-server.mcpb && bun scripts/clean-mcpb.ts dist/congressgov-mcp-server.mcpb",
     "changelog:build": "bun scripts/build-changelog.ts",
     "changelog:check": "bun scripts/build-changelog.ts --check",
     "clean": "bun scripts/clean.ts",
     "dev:http": "MCP_TRANSPORT_TYPE=http bun --watch src/index.ts",
     "dev:stdio": "MCP_TRANSPORT_TYPE=stdio bun --watch src/index.ts",
     "devcheck": "bun scripts/devcheck.ts",
     "format": "biome check --write .",
     "format:unsafe": "biome check --write --unsafe .",
     "lint:mcp": "bun scripts/lint-mcp.ts",
     "lint:packaging": "bun scripts/lint-packaging.ts",
     "list-skills": "bun scripts/list-skills.ts",
     "mirror:init": "bun run scripts/congress-mirror-init.ts",
     "mirror:refresh": "bun run scripts/congress-mirror-refresh.ts",
     "mirror:verify": "bun run scripts/congress-mirror-verify.ts",
     "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
     "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
     "release:github": "bun scripts/release-github.ts",
     "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js",
     "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
     "test": "vitest run",
     "tree": "bun scripts/tree.ts"
    },
    "shasum": "8fb5d8a22e54bd3373c976e4ec9e40dc3e41f43a",
    "type": "module",
    "types": "dist/index.d.ts",
    "version": "0.5.1"
   },
