    "name": "@fractalizer/mcp-cli",
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "directory": "packages/framework/cli",
     "type": "git",
     "url": "git+https://github.com/FractalizeR/mcp_servers.git"
    },
    "scripts": {
     "build": "tsc -b && tsc-alias",
     "clean": "rimraf dist",
     "cpd": "jscpd src",
     "cpd:quiet": "jscpd src --silent",
     "cpd:report": "jscpd src --reporters html,console",
     "depcruise": "depcruise src -c ../../../.dependency-cruiser.cjs",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
     "lint": "eslint src --ext .ts",
     "lint:fix": "eslint src --ext .ts --fix",
     "lint:quiet": "eslint src --ext .ts --quiet",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:quiet": "vitest run --reporter=dot --silent",
     "test:verbose": "vitest run --reporter=verbose",
     "test:watch": "vitest watch",
     "typecheck": "tsc --noEmit",
     "validate": "npm run lint && npm run typecheck && npm run test && npm run cpd && npm run depcruise && npm run validate:docs",
     "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
     "validate:quiet": "npm run lint:quiet && npm run typecheck && npm run test:quiet && npm run cpd:quiet && npm run depcruise && npm run validate:docs"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "1.5.0"
   },
