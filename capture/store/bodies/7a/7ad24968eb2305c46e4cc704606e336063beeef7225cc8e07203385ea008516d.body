  "_id": "@diskd-ai/email-client-mcp",
  "_rev": "46-6a19dfa3e35f726b9388a3b01bcda5ae",
  "bugs": {
   "url": "https://github.com/diskd-ai/email-client-mcp/issues"
  },
  "description": "Drive-backed multi-account email MCP with reliable IMAP-to-mailboxes sync.",
  "dist-tags": {
   "latest": "0.1.50"
  },
  "homepage": "https://github.com/diskd-ai/email-client-mcp#readme",
  "license": "LGPL-3.0-or-later",
  "maintainers": [
   {
    "email": "[redacted-email:2f05d7257e9c]",
