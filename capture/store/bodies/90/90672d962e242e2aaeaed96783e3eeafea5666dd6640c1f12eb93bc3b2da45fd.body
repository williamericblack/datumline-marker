    },
    "gitHead": "5cac9c1cd9c071f805dfeeb65096376036ae4505",
    "homepage": "https://github.com/alisaitteke/photoshop-mcp#readme",
    "keywords": [
     "mcp",
     "photoshop",
     "adobe",
     "automation",
     "ai",
     "model-context-protocol",
     "image-editing"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "maintainers": [
     {
      "email": "[redacted-email:b005b9027337]",
      "name": "axee"
     }
    ],
    "mcpName": "io.github.alisaitteke/photoshop-mcp",
    "name": "@alisaitteke/photoshop-mcp",
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/alisaitteke/photoshop-mcp.git"
    },
    "scripts": {
     "build": "npm run build:server && npm run build:web",
     "build:server": "tsc",
     "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
     "dev": "tsc --watch",
     "dev:ui": "concurrently -n server,web -c blue,green \"npm:dev:ui:server\" \"npm:dev:ui:web\"",
     "dev:ui:server": "tsx watch src/ui/cli.ts --port 5174 --no-open",
     "dev:ui:web": "npm --prefix web run dev",
     "format": "prettier --write \"src/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\"",
     "lint": "eslint src --ext .ts",
     "prepare": "npm run build",
     "prepublishOnly": "npm run build",
     "start": "node dist/index.js",
     "start:ui": "node dist/ui/cli.js"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "1.1.1"
   },
