     "shasum": "8944fbe5ec5383e7093b3a833e864d96b642dd99",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEUCIQDhOt66w1BIpvWao9C5iHweiOhJABzhn3XoZXomXj7ywgIgapL6NiDkOTCmD9Oywk1tRECMSPB2dBVHL5TbnSHBlCI="
