  "description": "A Model Context Protocol server that provides web content fetching capabilities with automatic image saving and optional AI display",
  "dist-tags": {
   "latest": "1.6.3"
  },
  "homepage": "https://github.com/kazuph/mcp-fetch#readme",
  "keywords": [
   "mcp",
   "fetch",
   "web",
   "content",
   "image",
   "processing",
   "claude",
   "ai"
  ],
  "license": "MIT",
