    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/cyanheads/mcp-ts-core.git"
    },
    "scripts": {
     "audit": "bun audit",
     "audit:fix": "bun audit --fix",
     "audit:refresh": "rm -f bun.lock && bun install && bun audit",
     "build": "bun run scripts/build.ts",
     "changelog:build": "bun run scripts/build-changelog.ts",
     "changelog:check": "bun run scripts/build-changelog.ts --check",
     "depcheck": "bunx depcheck",
     "deploy:dev": "MCP_TRANSPORT_TYPE=http bunx wrangler dev",
     "deploy:prod": "MCP_TRANSPORT_TYPE=http bunx wrangler deploy",
     "devcheck": "bun run scripts/devcheck.ts",
     "devdocs": "bun run scripts/devdocs.ts",
     "docs:generate": "bunx typedoc",
     "fetch-spec": "bun run scripts/fetch-openapi-spec.ts",
     "format": "biome check --write .",
     "format:unsafe": "biome check --write --unsafe .",
     "lint": "biome check",
     "lint:mcp": "bun run scripts/lint-mcp.ts",
     "lint:packaging": "bun run scripts/lint-packaging.ts",
     "prepare": "git config core.hooksPath .husky || exit 0",
     "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
     "rebuild": "bun run scripts/clean.ts && bun run build",
     "release:github": "bun run scripts/release-github.ts",
     "start": "bun ./dist/index.js",
     "start:http": "MCP_TRANSPORT_TYPE=http bun ./dist/index.js",
     "start:stdio": "MCP_TRANSPORT_TYPE=stdio bun ./dist/index.js",
     "test": "bunx vitest run",
     "test:all": "bun run rebuild && bun run test:coverage && bun run test:node && bun run test:worker && bun run test:integration",
     "test:compliance": "bunx vitest run --project compliance",
     "test:coverage": "bunx vitest run --coverage",
     "test:fuzz": "bunx vitest run --project fuzz",
     "test:integration": "bunx vitest run --config vitest.integration.ts",
     "test:leaks": "bunx vitest run --detect-async-leaks",
     "test:node": "sh -c 'NODE_BIN=$(which -a node | grep -v /bun-node- | head -n 1); \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs run && \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs run --config vitest.integration.ts'",
     "test:order": "sh -c 'NODE_BIN=$(which -a node | grep -v /bun-node- | head -n 1); \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs run --sequence.shuffle --sequence.seed=20260809 --expect.requireAssertions'",
     "test:package": "bun run rebuild && bunx vitest run --config vitest.package.ts",
     "test:smoke": "bunx vitest run --project smoke",
     "test:typecheck": "bunx vitest run --project typecheck",
     "test:ui": "bunx vitest --ui",
     "test:unit": "bunx vitest run --project unit",
     "test:worker": "sh -c 'NODE_BIN=$(which -a node | grep -v /bun-node- | head -n 1); \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs run --config vitest.worker.ts'",
     "tree": "bun run scripts/tree.ts",
     "typecheck": "bunx tsc --noEmit",
     "typecheck:scripts": "bunx tsc --project tsconfig.scripts.json --noEmit"
    },
