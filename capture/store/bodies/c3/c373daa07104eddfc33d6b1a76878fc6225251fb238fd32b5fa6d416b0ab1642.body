  "description": "MCP server for Next AI Draw.io - AI-powered diagram generation with real-time browser preview",
  "dist-tags": {
   "latest": "0.2.3"
  },
  "homepage": "https://next-ai-drawio.jiang.jp",
  "keywords": [
   "mcp",
   "drawio",
   "diagram",
   "ai",
   "claude",
