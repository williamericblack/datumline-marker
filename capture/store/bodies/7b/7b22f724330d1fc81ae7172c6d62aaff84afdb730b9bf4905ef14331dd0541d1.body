 "manifest": {
  "_id": "@jahandco/mcp-server",
  "_rev": "3-27d5e6877967d7eeb68977cfcdbc2276",
  "description": "Model Context Protocol (MCP) server for developing Jah and Co games with Game SDK, npx and jc CLI tooling",
  "dist-tags": {
   "latest": "0.3.0"
  },
  "license": "MIT",
  "maintainers": [
   {
