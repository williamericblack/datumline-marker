 "manifest": {
  "_id": "@ayushmudgal94/twilio-mcp",
  "_rev": "11-f22e5a7a518954b65ae8d8a0d24618c3",
  "author": {
   "name": "Twilio"
  },
  "description": "This is a Model Context Protocol server that exposes all of Twilio APIs.",
  "dist-tags": {
   "latest": "1.1.0"
  },
  "keywords": [
   "model context protocol",
   "mcp",
   "openapi",
   "twilio",
   "twilio api"
  ],
