 "manifest": {
  "_id": "@breadai/protocol-mcp-client",
  "_rev": "3-e593a36de531a4385851c1dc494a1416",
  "author": "Matteo Zambon <[redacted-email:fde0e07790e1]>",
  "description": "MCP client plugin for bread \u2014 connect agents to MCP servers (config-level or per-agent) over stdio, Streamable HTTP, or legacy SSE, with credential-aware auth signing.",
  "dist-tags": {
   "latest": "0.1.2"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "keywords": [
