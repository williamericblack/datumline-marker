 "manifest": {
  "_id": "@aeven/nanobanana-mcp",
  "_rev": "13-838cb8506e4e7d434ce7a0d960e2c4a3",
  "description": "MCP server for Nano Banana image generation (OpenRouter by default, configurable provider)",
