 "manifest": {
  "_id": "@ayushmudgal94/openapi-mcp-server",
  "_rev": "4-01bd524b1db1dbe2e5e94b65f3a2220b",
  "author": {
   "name": "Twilio"
  },
  "description": "A Model Context Protocol server that to expose OpenAPI specs.",
  "dist-tags": {
   "latest": "0.7.4"
  },
  "keywords": [
   "model context protocol",
   "mcp",
   "openapi"
  ],
  "license": "MIT",
  "maintainers": [
   {
    "email": "[redacted-email:81c0800f7aca]",
