     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEYCIQCjOVrCFgXoRDtHwCGoJXpnSM9h8IKJek5jGt39oqnAawIhAKq7BeCCW3xx+uGRI0yx6TyL6ynjd5YN98/BvjkKLT1G"
