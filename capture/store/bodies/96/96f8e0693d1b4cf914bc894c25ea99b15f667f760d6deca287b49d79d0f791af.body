 "manifest": {
  "_id": "@komplit/mcp-server",
  "_rev": "33-4fa8680da6d1ce8002c317376f641619",
  "description": "MCP (Model Context Protocol) server for the **Komplit Creative Platform** \u2014 AI agents use this as their sole interface for creative operations. Published to npm.",
  "dist-tags": {
   "latest": "0.1.36"
  },
