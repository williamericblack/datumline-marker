     "flatted": "3.4.0"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/IBM/ibmi-mcp-server.git"
    },
    "scripts": {
     "audit": "npm audit --production",
     "audit:fix": "npm audit fix --production",
     "build": "tsc && tsc-alias",
     "db:duckdb-example": "MCP_LOG_LEVEL=debug tsc && node dist/storage/duckdbExample.js",
     "depcheck": "npx depcheck",
     "deploy:debug": "./scripts/debug-deploy.sh",
     "deploy:debug:fast": "./scripts/debug-deploy.sh --skip-validation --skip-build",
     "deploy:debug:safe": "./scripts/debug-deploy.sh --skip-modules",
     "devdocs": "ts-node --esm scripts/devdocs.ts",
     "docs:generate": "typedoc --tsconfig ./tsconfig.typedoc.json",
     "fetch-spec": "tsx scripts/fetch-openapi-spec.ts",
     "format": "prettier --write \"**/*.{ts,js,json,html,css}\"",
     "generate-schemas": "tsx scripts/generate-json-schemas.ts",
     "inspector": "npx @modelcontextprotocol/inspector --config mcp.json --server default-server",
     "lint": "tsx scripts/lint.ts",
     "list-toolsets": "node dist/index.js --list-toolsets --tools ../tools",
     "mcpjam": "npx @mcpjam/cli",
     "pack:full": "rm -rf release && npm ci && npm run build && mkdir -p release/app && cp -R dist package.json package-lock.json node_modules release/app && tar -C release -czf release/ibmi-mcp-server-${npm_package_version}-full.tgz app",
     "postbuild": "tsx scripts/make-executable.ts dist/index.js dist/cli/index.js",
     "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
     "rebuild": "tsx scripts/clean.ts && npm run build",
     "release": "standard-version",
     "release:finalize": "./scripts/release-finalize.sh",
     "release:first": "standard-version --first-release",
     "release:major": "standard-version --release-as major",
     "release:minor": "standard-version --release-as minor",
     "release:patch": "standard-version --release-as patch",
     "release:prepare": "./scripts/release-prepare.sh",
     "release:prepare:major": "./scripts/release-prepare.sh major",
     "release:prepare:minor": "./scripts/release-prepare.sh minor",
     "release:prepare:patch": "./scripts/release-prepare.sh patch",
     "release:undo": "./scripts/release-undo.sh",
     "start": "node dist/index.js",
     "start:agent": "MCP_LOG_LEVEL=debug node dist/agent/cli/boot.js",
     "start:http": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=http node dist/index.js",
     "start:stdio": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=stdio node dist/index.js",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:watch": "vitest",
     "tree": "tsx scripts/tree.ts",
     "typecheck": "tsc --noEmit",
     "validate": "tsx scripts/validate-config.ts"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "version": "0.4.5"
   },
