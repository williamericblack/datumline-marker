     ],
     "tarball": "https://registry.npmjs.org/@finchtoys/mcp-client/-/mcp-client-1.2.10.tgz",
     "unpackedSize": 112306
    },
    "finch": {
     "activationEvents": [
      "onStartup"
     ],
     "autoEnable": true,
     "categories": [
      "mcp",
      "developer"
