     "contributes": {
      "skills": false,
      "tools": true
     },
     "description": "Connect to Model Context Protocol servers, expose their tools to the Finch, and provide an mcp.client capability for other extensions.",
     "extensionType": "official",
     "id": "mcp",
     "main": "dist/index.js",
     "manifestVersion": 1,
     "name": "MCP Client",
     "permissions": {
      "filesystem": "read",
      "network": true,
      "oauth": [
       "mcp"
      ],
      "shell": true
     },
     "privacyPolicyUrl": "https://finchwork.app/privacy",
     "promptGuides": [
      {
       "description": "Ask Finch to help create a local servers.json config for filesystem access.",
       "id": "setup-filesystem",
       "prompt": "Help me configure MCP Client with a filesystem MCP server for my current project directory.",
       "title": "Connect a filesystem MCP server"
      }
     ],
     "provides": {
      "capabilities": [
       "mcp.client"
      ]
     },
     "systemPrompt": "Use MCP with action=list/add/edit/remove/connect/disconnect to manage configured MCP services. For an OAuth-enabled HTTP MCP service, action=connect runs OAuth discovery, Dynamic Client Registration, and PKCE; do not check status first when the user asks to authorize. Never ask users to paste secrets in chat, because add/edit opens a secure form for secret values. To add an HTTP (url) MCP server just pass name+url \u2014 the form shows one API-token field and auto-creates a standard 'Authorization: Bearer <token>' header; never pass, view, or hand-edit the token or any header, and only set authHeader for a non-standard header name (e.g. X-Api-Key). To use actual MCP server tools, when the target server name is known first call Finch ToolSearch with source:\"mcp:<server>\"; fall back to source:\"mcp\" only if that precise search finds no usable tool, because mcp__<server>__<tool> names are never pre-loaded and will fail if called directly. ToolSearch connects the selected servers, discovers their tools, and injects mcp__<server>__<tool> functions into the current run. Authorization can be granted per-tool (mcp__filesystem__read_file) or with a wildcard (mcp__filesystem__*).",
     "termsOfServiceUrl": "https://finchwork.app/terms",
     "toolMeta": {
      "name": "MCP"
     }
    },
