    },
    "directories": {},
    "dist": {
     "fileCount": 9,
     "integrity": "sha512-+1HHxyd/785TwRbrWcJ6agWJtpBdhKiJl7zr5zCtSIXZnG7I9JMOQkS0f2U7EqXM6WQjIFoKwjpTkxiD6M3XKA==",
