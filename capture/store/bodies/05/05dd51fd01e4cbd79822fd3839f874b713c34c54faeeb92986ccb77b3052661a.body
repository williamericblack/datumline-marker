    },
    "scripts": {
     "benchmark:profile": "tsx scripts/benchmark-profile-registration.ts",
     "build": "tsc",
     "clean": "rm -rf dist",
     "dev": "tsx src/index.ts",
     "docker:build": "docker build -t businessmap-mcp .",
     "docker:down": "docker-compose down",
     "docker:logs": "docker-compose logs -f businessmap-mcp",
     "docker:run": "docker run --env-file .env businessmap-mcp",
     "docker:up": "docker-compose up -d",
     "format": "prettier --write src/**/*.ts",
     "lint": "eslint src/**/*.ts",
     "lint:fix": "eslint src/**/*.ts --fix",
     "measure:baseline": "tsx scripts/measure-baseline.ts",
     "measure:profile": "tsx scripts/measure-profile.ts",
     "postbuild": "chmod +x dist/index.js",
     "prepare": "husky install",
     "prepublishOnly": "npm run build",
     "preview:release": "bash scripts/preview-release-notes.sh",
     "publish:github": "bash scripts/publish-github.sh",
     "publish:npm": "bash scripts/publish-npm.sh",
     "setup": "bash scripts/setup.sh",
     "start": "node dist/index.js",
     "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.js",
     "test:all": "npm run test:unit && npm run test:integration && npm run test:performance",
     "test:connection": "bash scripts/test-connection.sh",
     "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.integration.config.js",
     "test:npx": "bash scripts/test-npx.sh",
     "test:performance": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.performance.config.js",
     "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.js",
     "watch": "tsx --watch src/index.ts"
    },
