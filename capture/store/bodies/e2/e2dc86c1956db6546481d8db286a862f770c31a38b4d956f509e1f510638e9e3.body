    "mcpName": "io.github.localstack/localstack-mcp-server",
    "name": "@localstack/localstack-mcp-server",
    "repository": {
     "type": "git",
     "url": "https://github.com/localstack/localstack-mcp-server"
    },
    "resolutions": {
     "@hono/node-server": "^2.0.5",
     "ip-address": "^10.1.1"
    },
    "scripts": {
     "build": "xmcp build && yarn build:cli",
     "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --target=node22 --tsconfig=tsconfig.cli.json --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --outfile=dist/cli.js --external:./stdio.js \"--banner:js=#!/usr/bin/env node\" --log-level=warning",
     "dev": "xmcp dev",
     "format": "prettier --write .",
     "prepack": "yarn build",
     "start": "node dist/stdio.js",
     "test": "jest",
     "test:mcp": "yarn test:mcp:direct && yarn test:mcp:evals",
     "test:mcp:direct": "yarn build && playwright test -c playwright.config.mjs tests/mcp/direct.spec.mjs",
     "test:mcp:evals": "yarn build && playwright test -c playwright.config.mjs tests/mcp/evals-gemini.spec.mjs"
    },
    "version": "0.6.0"
   }
  }
 },
 "name": "@localstack/localstack-mcp-server",
 "registry": "npm",
 "source_url": "https://registry.npmjs.org/@localstack%2Flocalstack-mcp-server"
