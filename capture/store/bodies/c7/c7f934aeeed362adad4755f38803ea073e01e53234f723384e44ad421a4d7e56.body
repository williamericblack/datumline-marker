  "description": "OpenClaw MCP plugin \u2014 thin wrapper around @aiwerk/mcp-bridge for seamless MCP server integration",
  "dist-tags": {
   "latest": "0.14.1"
  },
  "homepage": "https://github.com/AIWerk/openclaw-mcp-bridge#readme",
  "keywords": [
   "openclaw",
