 "manifest": {
  "_id": "@atom8n/mcp-logger",
  "_rev": "8-ce722217e2c0b7dac4efa70ad5580a82",
  "description": "A MCP server to fetch logs from localhost:6277",
  "dist-tags": {
   "latest": "0.5.3"
  },
  "license": "MIT",
  "maintainers": [
   {
    "email": "[redacted-email:db7596540e9e]",
