    "repository": {
     "directory": "packages/servers/yandex-tracker",
     "type": "git",
     "url": "git+https://github.com/FractalizeR/mcp_servers.git"
    },
    "scripts": {
     "benchmark": "tsx benchmarks/cli-performance.ts",
     "benchmark:all": "npm run benchmark && npm run benchmark:bundle && npm run benchmark:memory",
     "benchmark:bundle": "bash benchmarks/bundle-size.sh",
     "benchmark:memory": "tsx benchmarks/memory-usage.ts",
     "build": "tsc -b && tsc-alias && npm run build:bundle",
     "build:bundle": "tsup",
     "build:mcpb": "npm run build && tsx ../scripts/increment-build.ts && tsx ../scripts/build-mcpb.ts",
     "clean": "rimraf dist",
     "cpd": "jscpd src",
     "cpd:quiet": "jscpd src --silent",
     "cpd:report": "jscpd src --reporters html,console",
     "depcruise": "cd ../../.. && depcruise packages/servers/yandex-tracker/src -c .dependency-cruiser.cjs",
     "dev": "npm run build && node dist/yandex-tracker.bundle.cjs",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "lint": "eslint src scripts --ext .ts",
     "lint:fix": "eslint src scripts --ext .ts --fix",
     "lint:quiet": "eslint src scripts --ext .ts --quiet",
     "mcp:connect": "npm run build && node dist/cli/bin/mcp-connect.js connect",
     "mcp:disconnect": "npm run build && node dist/cli/bin/mcp-connect.js disconnect",
     "mcp:list": "npm run build && node dist/cli/bin/mcp-connect.js list",
     "mcp:status": "npm run build && node dist/cli/bin/mcp-connect.js status",
     "migrate:subpath-imports": "tsx scripts/migrate-to-subpath-imports.ts",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:perf": "tsx scripts/analyze-test-performance.ts",
     "test:quiet": "vitest run --reporter=dot --silent",
     "test:raw-wire": "tsx scripts/raw-wire-test.ts",
     "test:smoke": "vitest run tests/smoke",
     "test:smoke:server": "tsx scripts/smoke-test-server.ts",
     "test:verbose": "vitest run --reporter=verbose",
     "test:watch": "vitest watch",
     "typecheck": "tsc --noEmit",
     "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
     "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
     "validate": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm run test && npm run test:smoke && npm run test:smoke:server && npm run test:raw-wire && npm run cpd && npm run depcruise && npm run validate:docs && npm run validate:tools",
     "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
