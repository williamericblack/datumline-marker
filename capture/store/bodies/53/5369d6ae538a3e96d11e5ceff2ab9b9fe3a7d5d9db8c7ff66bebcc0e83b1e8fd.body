    "name": "@mozilla/firefox-devtools-mcp",
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/mozilla/firefox-devtools-mcp.git"
    },
    "scripts": {
     "build": "tsup",
     "build:all": "npm run build && npm run build:moz",
     "build:mcpb": "node scripts/build-mcpb.mjs",
     "build:moz": "node scripts/generate-moz-package.mjs && tsup --config tsup.config.moz.ts",
     "check": "npm run lint:fix && npm run typecheck",
     "check:all": "npm run check && npm run test:run && npm run build",
     "clean": "rm -rf dist",
     "dev": "tsx watch src/index.moz.ts",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
     "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
     "inspector:dev": "NODE_ENV=development npx @modelcontextprotocol/inspector npx tsx src/index.moz.ts",
     "lint": "eslint src --ext .ts",
     "lint:fix": "eslint src --ext .ts --fix",
     "prepublishOnly": "npm run clean && npm run build",
     "publish:moz": "node scripts/publish-moz-package.mjs",
     "setup": "node scripts/setup-mcp-config.js",
     "start": "node dist/index.js",
     "test": "vitest",
     "test:console": "node scripts/test-console.js",
     "test:coverage": "vitest run --coverage",
     "test:dialog": "node scripts/test-dialog.js",
     "test:firefox-temp": "node scripts/test-firefox-temp.js",
     "test:input": "node scripts/test-input-tools.js",
     "test:integration:win": "node scripts/run-integration-tests-windows.mjs",
     "test:lifecycle": "node scripts/test-lifecycle-hooks.js",
     "test:mozlog": "node scripts/test-mozlog.js",
     "test:navigation": "node scripts/test-navigation.js",
     "test:privileged": "node scripts/test-privileged-context.js",
     "test:run": "vitest run",
     "test:screenshot": "node scripts/test-screenshot.js",
     "test:tools": "node scripts/test-bidi-devtools.js",
     "test:ui": "vitest --ui",
     "test:unit": "vitest run --exclude 'tests/integration/**'",
     "test:watch": "vitest watch",
     "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "version": "0.9.15"
   },
