     "build": "npx tsc --build tsconfig.json && tsup",
     "build:tsc": "tsc -p tsconfig.json",
     "clean": "rm -rf dist *.tsbuildinfo",
     "dev": "tsc -p tsconfig.json --watch",
     "lint": "tsc --noEmit",
     "test": "vitest run"
    },
