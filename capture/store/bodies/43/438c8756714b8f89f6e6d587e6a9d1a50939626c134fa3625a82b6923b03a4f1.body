     "lint:fix": "eslint . --fix",
     "logs:watch": "npx mcps-logger",
     "prepare": "husky",
     "start": "node build/index.js",
     "test": "vitest",
     "test:run": "vitest run",
     "update-licenses": "node scripts/update-licenses.js"
    },
