  },
  "homepage": "https://github.com/kevinwatt/mcp-server-searxng#readme",
  "keywords": [
   "mcp",
   "searxng",
   "search",
   "meta-search",
   "claude",
   "dive",
   "ai"
  ],
  "license": "MIT",
  "maintainers": [
