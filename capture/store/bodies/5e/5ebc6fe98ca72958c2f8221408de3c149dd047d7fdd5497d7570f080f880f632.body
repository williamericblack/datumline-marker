    "scripts": {
     "build": "nest build",
     "clean": "rm -rf dist dist-stdio dist-http node_modules",
     "e2e:down": "cd .docker && docker compose down",
     "e2e:full:local": "./scripts/e2e-full.sh",
     "e2e:logs": "cd .docker && docker compose logs -f",
     "e2e:test": "NODE_OPTIONS=--experimental-vm-modules jest --config test/e2e/jest-e2e.config.js",
     "e2e:test:http": "NODE_OPTIONS=--experimental-vm-modules jest --config test/e2e/jest-e2e.config.js --testPathPatterns='http\\.e2e-spec'",
     "e2e:test:stdio": "NODE_OPTIONS=--experimental-vm-modules jest --config test/e2e/jest-e2e.config.js --testPathPatterns='stdio\\.e2e-spec'",
     "e2e:up": "cd .docker && docker compose up -d",
     "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
     "generate:icon": "node scripts/generate-icon.mjs",
     "inspector:http": "mcp-inspector --config mcp-inspector-config.json --server http-server",
     "inspector:stdio": "mcp-inspector --config mcp-inspector-config.json --server stdio-server",
     "inspector:stdio:debug": "mcp-inspector --config mcp-inspector-config.json --server stdio-server-debug",
     "install:local": "npm install -g ./ankimcp-anki-mcp-server-*.tgz",
     "install:npm": "npm install -g @ankimcp/anki-mcp-server@tunnel",
     "lint": "eslint \"{src,test}/**/*.ts\" --fix",
     "mcpb:bundle": "npm run sync-version && npm run mcpb:clean && npm run build && mcpb pack . \"anki-mcp-server-$npm_package_version.mcpb\" && mcpb clean \"anki-mcp-server-$npm_package_version.mcpb\"",
     "mcpb:clean": "rm -f *.mcpb",
     "pack:local": "rm -f *.tgz && npm run build && npm pack",
     "prebuild": "npm run generate:icon",
     "prepare": "husky",
     "smoke:pack": "npm run build && bash scripts/smoke-test-pack.sh",
     "start:debug:http": "nest start --debug --watch --entryFile main-http",
     "start:debug:stdio": "nest start --debug --watch --entryFile main-stdio",
     "start:dev:http": "nest start --watch --entryFile main-http",
     "start:dev:stdio": "nest start --watch --entryFile main-stdio",
     "start:dev:tunnel": "nest start --watch --entryFile main-tunnel -- --tunnel --debug",
     "start:prod:http": "node dist/main-http",
     "start:prod:stdio": "node dist/main-stdio",
     "sync-version": "node scripts/sync-version.js",
     "test": "NODE_OPTIONS=--experimental-vm-modules jest",
     "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --silent --maxWorkers=2",
     "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
     "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
     "test:single": "npm test -- src/mcp/primitives/essential/tools/__tests__/delete-notes.tool.spec.ts",
     "test:tools": "NODE_OPTIONS=--experimental-vm-modules jest src/mcp/primitives/essential/tools/__tests__ --silent",
     "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns='spec\\.ts$' --silent",
     "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
     "test:workflows": "NODE_OPTIONS=--experimental-vm-modules jest test/workflows --silent",
     "type-check": "tsc --noEmit",
     "uninstall:local": "npm uninstall -g @ankimcp/anki-mcp-server",
     "upgrade:interactive": "npx npm-check-updates -i"
    },
