     "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**",
      "!src/test-fixtures/**",
      "!src/main.ts",
      "!src/main-stdio.ts",
