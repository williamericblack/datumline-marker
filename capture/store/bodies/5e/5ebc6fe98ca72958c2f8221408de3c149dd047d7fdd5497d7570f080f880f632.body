     "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
     "inspector:http": "mcp-inspector --config mcp-inspector-config.json --server http-server",
     "inspector:stdio": "mcp-inspector --config mcp-inspector-config.json --server stdio-server",
     "inspector:stdio:debug": "mcp-inspector --config mcp-inspector-config.json --server stdio-server-debug",
