     "test:unit": "jest --testPathPatterns='spec\\.ts$' --silent",
     "test:watch": "jest --watch",
     "test:workflows": "jest test/workflows --silent",
     "type-check": "tsc --noEmit",
     "uninstall:local": "npm uninstall -g @ankimcp/anki-mcp-server"
