    "jest": {
     "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**",
      "!src/test-fixtures/**",
      "!src/main.ts",
      "!src/main-stdio.ts",
      "!src/main-http.ts",
      "!src/**/index.ts"
     ],
     "coverageDirectory": "coverage",
     "coverageThreshold": {
      "global": {
       "branches": 70,
       "functions": 70,
       "lines": 70,
       "statements": 70
      }
     },
     "forceExit": true,
     "moduleFileExtensions": [
      "js",
      "json",
      "ts"
     ],
     "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
     },
     "rootDir": ".",
     "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
     ],
     "testEnvironment": "node",
     "testRegex": ".*\\.(spec|test)\\.ts$",
     "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
     },
     "transformIgnorePatterns": [
      "node_modules/(?!(ky|unified|remark-parse|unist-util-visit|mdast-util-to-string|micromark.*|decode-named-character-reference|character-entities|unist-.*|vfile.*|bail|is-plain-obj|trough|devlop|mdast.*|hast.*)/)"
