     "lint": "eslint src/**/*.ts",
     "lint:fix": "eslint src/**/*.ts --fix",
     "mcp:inspector": "NODE_ENV=development npx @modelcontextprotocol/inspector -e HEROUI_API_URL=http://localhost:8787 tsx src/stdio.ts",
     "mcp:stdio": "NODE_ENV=development tsx src/stdio.ts",
     "prepublishOnly": "pnpm build",
