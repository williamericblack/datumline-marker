    "scripts": {
     "build": "tsc && npx esbuild dist/*.js dist/fingerprint/*.js --minify --outdir=dist --allow-overwrite",
     "build:goja": "npx esbuild src/fingerprint/goja-entry.ts --bundle --format=iife --global-name=FP --platform=neutral --outfile=../../pkg/fingerprint/bundle.js",
