    "name": "@github/mcp-registry",
    "publishConfig": {
     "access": "public"
    },
    "scripts": {
     "build": "tsc && npx esbuild dist/*.js dist/fingerprint/*.js --minify --outdir=dist --allow-overwrite",
     "build:goja": "npx esbuild src/fingerprint/goja-entry.ts --bundle --format=iife --global-name=FP --platform=neutral --outfile=../../pkg/fingerprint/bundle.js",
     "clean": "rm -rf dist",
     "prepublishOnly": "npm run clean && npm run build",
     "test": "vitest run --exclude '**/**.integration.test.ts'",
     "test:integration": "vitest run src/client.integration.test.ts",
     "test:watch": "vitest --exclude '**/*.integration.test.ts'"
    },
    "types": "dist/index.d.ts",
    "version": "0.1.4"
   },
