    "scripts": {
     "build": "tsup src/index.ts --format esm --clean && tsx scripts/build-copy-assets.ts",
     "changeset": "changeset",
     "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
     "clean": "rm -rf dist build",
     "dev": "tsup src/index.ts --watch --format esm",
     "docs": "tsx scripts/build-typedoc-setup.ts && pnpm typedoc",
     "docs:generate": "pnpm run docs",
     "docs:parse-html": "tsx scripts/build-api-docs-from-html.ts",
     "download:examples": "tsx scripts/fetch-awesome-nutrient-readme.ts",
     "download:guides": "tsx scripts/fetch-guides-from-web.ts",
     "format": "oxfmt",
     "format:check": "oxfmt --check",
     "generate": "rm -rf build && pnpm run docs && pnpm run generate:types && pnpm run generate:guides-json && pnpm run generate:changelog && pnpm run generate:examples-json && pnpm run docs:parse-html",
     "generate:changelog": "tsx scripts/build-changelog-search-index.ts",
     "generate:examples-json": "tsx scripts/build-examples-search-index.ts",
     "generate:guides-json": "tsx scripts/build-guides-search-index.ts",
     "generate:types": "tsx scripts/build-minified-types.ts",
     "lint": "oxlint",
     "lint:fix": "oxlint --fix",
     "mcp": "tsx src/index.ts",
     "prebuild": "pnpm run generate",
     "pretest": "pnpm run build",
     "release": "pnpm run build && changeset publish",
     "start": "tsx src/index.ts",
     "test": "vitest",
     "test:api": "tsx ./scripts/dev-test-mcp-tools.ts",
     "test:coverage": "vitest --coverage",
     "test:watch": "vitest --watch",
     "typecheck": "tsc --noEmit",
     "version": "changeset version"
    },
    "type": "module",
    "version": "0.1.0"
