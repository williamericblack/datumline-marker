 "manifest": {
  "_id": "@assetlab/mcp-server",
  "_rev": "55-434511ade4e81db24c9c36786f0fb3c1",
  "description": "MCP server for AssetLab \u2014 connect Claude or ChatGPT to your asset management data",
  "dist-tags": {
   "latest": "2.9.0"
  },
  "keywords": [
   "mcp",
   "assetlab",
