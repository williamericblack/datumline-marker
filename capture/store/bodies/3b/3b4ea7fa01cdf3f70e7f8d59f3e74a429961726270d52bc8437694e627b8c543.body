     "@modelcontextprotocol/client": "2.0.0",
     "@modelcontextprotocol/server": "2.0.0",
     "@opentelemetry/api": "^1.9.0",
     "react": "^19.2.7"
    },
    "peerDependenciesMeta": {
     "@opentelemetry/api": {
      "optional": true
     },
     "react": {
      "optional": true
     }
    },
    "publishConfig": {
     "access": "public",
     "provenance": true
    },
    "repository": {
     "directory": "packages/mcp-query",
     "type": "git",
     "url": "git+https://github.com/johnhenry/mcp-query.git"
    },
    "scripts": {
     "build": "tsc -p tsconfig.build.json && chmod +x dist/codegen/cli.js dist/cli/inspect.js",
     "codegen": "tsx src/codegen/cli.ts",
     "example:01": "tsx examples/01-minimal.ts",
     "example:02": "tsx examples/02-cache-and-invalidation.ts",
     "example:03": "tsx examples/03-live-subscriptions.ts",
     "example:04": "tsx examples/04-multi-server.ts",
     "example:05": "tsx examples/05-human-in-the-loop.ts",
     "example:06": "tsx examples/06-alongside-another-client.ts",
     "example:node": "tsx examples/node-everything.ts",
     "inspect": "tsx src/cli/inspect.ts",
     "prepack": "npm run build",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:stress": "NODE_OPTIONS=--expose-gc vitest run -c vitest.stress.config.ts",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
    "sideEffects": false,
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.0.0"
   }
  }
 },
 "name": "@johnhenry/mcp-query",
 "registry": "npm",
 "source_url": "https://registry.npmjs.org/@johnhenry%2Fmcp-query"
}