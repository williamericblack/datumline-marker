    "bin": {
     "gpt-image-1-mcp": "build/index.js"
    },
    "dependencies": {
     "@modelcontextprotocol/sdk": "^1.11.0",
     "form-data": "^4.0.0",
     "node-fetch": "^3.3.2",
     "openai": "^4.97.0",
