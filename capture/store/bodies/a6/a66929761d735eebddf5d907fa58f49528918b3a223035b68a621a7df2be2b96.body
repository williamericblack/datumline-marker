 "manifest": {
  "_id": "@cloudwerxlab/gpt-image-1-mcp",
  "_rev": "9-5861920e8ed250b1f964544588cf4ab4",
  "description": "A Model Context Protocol server for OpenAI's gpt-image-1 model, supports Image Generation and Editing/Masks.",
  "dist-tags": {
