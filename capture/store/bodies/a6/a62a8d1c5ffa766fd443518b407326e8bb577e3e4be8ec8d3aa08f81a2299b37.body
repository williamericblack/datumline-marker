     "fileCount": 8,
     "integrity": "sha512-iL3CEwLzaYlASnscQcrlVDIPHoDxOXKs0KFh9tZJZ+rUP0JBCgkpty2p0rHDB0i/L5EFqzNxW/6DyUud9ChdUA==",
     "shasum": "ba31347232719f21b678f6f57080dcfb584bde31",
     "signatures": [
