 "manifest": {
  "_id": "@aroha-sdk/mcp-guard",
  "_rev": "2-297e3130a58717c6e38ff20ac16bfafb",
  "description": "A firewall for your AI agent's tools \u2014 wrap any MCP server with spending limits, action limits, human approval gates, and a full audit log. Zero code, one config change.",
  "dist-tags": {
