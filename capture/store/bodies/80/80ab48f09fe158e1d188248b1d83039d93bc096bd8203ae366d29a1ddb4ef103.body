    },
    "directories": {},
    "dist": {
     "fileCount": 298,
     "integrity": "sha512-naCJI2spHzQH0se6/sqhAGXnjoZHXXDvnCHbXuurGPoR0J34/bgVeXplo2KRWmoyOft5MWOI1OMG+K00FA1gxg==",
     "shasum": "873152ac441abd579908faff268a864839cb6ec9",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEUCIQCqy5NXs/Vy/wUHiDFpj5Q70OX1yRygjrWsT6R/5JjspAIgH7A8Z6NHc46VjeKdME3rhPH4PtyRVqKYGAZwel3yrUw="
      }
     ],
     "tarball": "https://registry.npmjs.org/@kud/mcp-datadog/-/mcp-datadog-0.1.0.tgz",
     "unpackedSize": 218177
    },
    "engines": {
     "node": ">=20.0.0"
    },
    "gitHead": "7953e88658e889c2d0f0375f03b493d0c1f6b30f",
    "keywords": [
     "datadog",
     "mcp",
     "mcp-server",
     "monitoring",
     "metrics",
     "logs",
     "observability"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "maintainers": [
     {
      "email": "[redacted-email:f2727d0aeb18]",
      "name": "kud"
     }
    ],
    "name": "@kud/mcp-datadog",
    "scripts": {
     "build": "tsc -p tsconfig.json",
     "build:watch": "tsc -p tsconfig.json --watch",
     "clean": "rm -rf dist",
     "dev": "tsx src/index.ts",
     "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
     "inspect:dev": "npx @modelcontextprotocol/inspector tsx src/index.ts",
     "prepublishOnly": "npm run clean && npm run build",
     "start": "node dist/index.js",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:ui": "vitest --ui",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "version": "0.1.0"
   },
