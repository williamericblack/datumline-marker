 "manifest": {
  "_id": "@catapulta/mcp-server",
  "_rev": "16-8a98e3628366302d45bcbe494107599a",
  "author": {
   "name": "Catapulta"
  },
  "description": "Catapulta MCP Server",
  "dist-tags": {
   "latest": "0.7.4"
  },
  "maintainers": [
