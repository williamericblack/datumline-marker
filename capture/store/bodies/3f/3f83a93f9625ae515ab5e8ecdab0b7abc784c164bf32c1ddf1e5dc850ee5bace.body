  },
  "description": "Model Context Protocol server exposing DevFlow context, memory, knowledge, and workflow tools.",
  "dist-tags": {
   "latest": "0.18.20"
  },
  "homepage": "https://github.com/shilongfeicool/dev-flow#readme",
