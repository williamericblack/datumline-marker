 "manifest": {
  "_id": "@goplausible/algorand-mcp",
  "_rev": "49-015cd32f98551b6bb81b506efb26b6b8",
  "description": "Algorand Model Context Protocol Local Implementation",
  "dist-tags": {
   "latest": "4.4.0"
  },
  "keywords": [
