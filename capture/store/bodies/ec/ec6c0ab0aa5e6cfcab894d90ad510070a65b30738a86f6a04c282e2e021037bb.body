  },
  "description": "Model Context Protocol (MCP) Server for Plexo - Landing page generation, email templates, publishing, and analytics.",
  "dist-tags": {
   "latest": "1.0.10"
  },
  "homepage": "https://plexo.charisol.io",
  "keywords": [
   "plexo",
   "mcp",
   "model-context-protocol",
   "claude",
   "chatgpt",
   "cursor",
   "landing-page",
   "email-builder"
  ],
