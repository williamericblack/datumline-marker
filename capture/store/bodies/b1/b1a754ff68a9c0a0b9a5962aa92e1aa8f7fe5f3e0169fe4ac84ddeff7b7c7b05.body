 "manifest": {
  "_id": "@lionchat/mcp-server",
  "_rev": "74-2cf12bda78ebf9ac78ae4876da7ee31e",
  "description": "MCP server for LionChat API \u2014 547 tools + 10 resources + 9 prompts. Audit-log aware, completion API, progress notifications.",
