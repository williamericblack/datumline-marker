     "@lokascript/domain-flow": "^2.8.0",
     "@lokascript/domain-jsx": "^2.8.0",
     "@lokascript/domain-learn": "^2.8.0",
     "@lokascript/domain-llm": "^2.8.0",
     "@lokascript/domain-sql": "^2.8.0",
     "@lokascript/domain-todo": "^2.8.0",
