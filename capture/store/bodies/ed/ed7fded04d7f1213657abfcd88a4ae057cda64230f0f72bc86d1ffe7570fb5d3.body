 "manifest": {
  "_id": "@i18n-agent/mcp-client",
  "_rev": "500-c8cf7b7083f9db81dc68287231971a7a",
  "author": {
   "name": "FatCouple O\u00dc"
  },
  "bugs": {
   "url": "https://github.com/i18n-agent/mcp-client/issues"
  },
  "description": "\ud83c\udf0d i18n-agent MCP Client - 48 languages, AI-powered translation for Claude, Claude Code, Cursor, VS Code, Codex. Get API key at https://app.i18nagent.ai",
  "dist-tags": {
   "latest": "1.16.3"
  },
  "homepage": "https://i18nagent.ai",
  "keywords": [
   "i18n",
   "translation",
   "mcp",
   "claude",
   "cursor",
   "vscode",
   "ai",
   "internationalization",
