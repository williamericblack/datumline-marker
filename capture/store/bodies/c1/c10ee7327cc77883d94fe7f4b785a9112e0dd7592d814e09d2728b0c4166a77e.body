     "prepublishOnly": "npm run check && npm run build",
     "test": "tsx --test tests/*.test.ts",
     "test:artifact-canary": "npm run build && node scripts/run-publish-canary.mjs",
     "test:platform-canary": "node scripts/run-publish-canary.mjs --require-platform",
     "typecheck": "tsc --noEmit",
     "typecheck:all": "tsc --noEmit -p tsconfig.test.json"
    },
