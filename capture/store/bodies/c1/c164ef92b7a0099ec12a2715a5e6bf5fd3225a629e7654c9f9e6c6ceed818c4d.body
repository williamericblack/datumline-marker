    "private": false,
    "repository": {
     "type": "git",
     "url": "git+https://github.com/tonykimeu/craft-it.git"
    },
    "scripts": {
     "build": "tsc && chmod +x build/cli.js",
     "build:all": "npm run build && npm run build:web",
     "build:bun": "bun build src/cli.ts --outdir build --target node",
     "build:node": "./build.sh",
     "build:web": "bun build src/index.ts --outdir build --target node",
     "dev": "bun --watch src/index.ts",
     "dev:node": "nodemon --exec node build/index.js",
     "dev:web": "bun --watch src/index.ts",
     "dev:web:node": "nodemon --exec node build/index.js",
     "docker:build": "docker build -t craft-it-mcp .",
     "docker:run": "docker run -p 3001:3001 --env-file .env craft-it-mcp",
     "postpublish": "mv README.md.bak README.md",
     "prepare": "npm run build",
     "prepublishOnly": "cp NPM-README.md README.md.bak && cp NPM-README.md README.md",
     "start": "node build/cli.js",
     "start:bun": "bun run src/cli.ts",
     "start:node": "node build/cli.js",
     "start:web": "node build/index.js",
     "start:web:bun": "bun run src/index.ts",
     "test:npm": "./test-npm.sh"
    },
    "type": "module",
    "types": "./build/cli.d.ts",
    "version": "1.0.0"
   },
