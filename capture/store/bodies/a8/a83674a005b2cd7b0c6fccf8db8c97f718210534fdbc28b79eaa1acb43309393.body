    "name": "@convertcom/mcp-server",
    "optionalDependencies": {
     "@huggingface/transformers": "4.2.0",
     "@zvec/zvec": "0.6.0"
    },
    "repository": {
     "directory": "packages/server",
     "type": "git",
     "url": "git+https://github.com/convertcom/convert-mcp.git"
    },
    "scripts": {
     "build": "yarn build:validators && rm -rf build && tsc -p tsconfig.npm.json && chmod 755 build/index.js",
     "build:brand-icons": "node scripts/build-brand-icons.mjs",
     "build:remote": "yarn build:remote:check && yarn dry-run:remote:staging && yarn dry-run:remote:production",
     "build:remote:check": "yarn prepare:mcp-app-assets && yarn build:validators && tsc -p tsconfig.remote.json",
     "build:remote:production": "yarn build:remote",
     "build:remote:staging": "yarn build:remote:check && yarn dry-run:remote:staging",
     "build:validators": "tsx scripts/build-validators.ts",
     "build:vectors": "tsx scripts/build-vectors.ts",
     "build:worker-vectors": "tsx scripts/build-vectors.ts",
     "deploy:remote:production": "node ../../scripts/check-remote-profile-configs.mjs --profile hosted --environment production && node ../../scripts/check-remote-vector-index.mjs production && node ../../scripts/check-remote-ai.mjs production && yarn build:remote:check && node ../../scripts/deploy-remote-worker.mjs production",
     "deploy:remote:staging": "node ../../scripts/check-remote-profile-configs.mjs --profile hosted --environment staging && node ../../scripts/check-remote-vector-index.mjs staging && node ../../scripts/check-remote-ai.mjs staging && yarn build:remote:check && node ../../scripts/deploy-remote-worker.mjs staging",
     "dev": "tsx src/index.ts",
     "dev:remote": "wrangler dev --config wrangler.remote.jsonc --env staging",
     "dev:remote:production": "wrangler dev --config wrangler.remote.jsonc --env production",
     "dry-run:remote:production": "wrangler deploy --config wrangler.remote.jsonc --env production --dry-run --outdir build-remote-production",
     "dry-run:remote:staging": "wrangler deploy --config wrangler.remote.jsonc --env staging --dry-run --outdir build-remote-staging",
     "generate": "node ../../scripts/generate.mjs",
     "lint": "eslint \"src/**/*.{ts,tsx}\"",
     "prepare:mcp-app-assets": "yarn build:brand-icons && node scripts/prepare-mcp-app-assets.mjs",
     "prestart": "npm run build",
     "record:mcp-app-baseline": "tsx scripts/record-mcp-app-baseline.ts",
     "start": "node build/index.js",
     "start:remote": "yarn dev:remote",
     "stdio-to-remote": "npx -y supergateway --stdio 'yarn start' --port 5001",
     "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
     "test:remote": "yarn build:remote && NODE_OPTIONS='--experimental-vm-modules' jest --runInBand brand-assets.test.ts remote-worker.test.ts remote-session-context.test.ts remote-session-persistence.test.ts connect-bridge.test.ts deployment-profile.test.ts remote-telemetry.test.ts remote-feedback.test.ts feedback.test.ts kb-search-worker.test.ts tool-schema-metadata.test.ts runtime-server.test.ts split-tool-surface.test.ts chatgpt-app.test.ts remote-impersonation.test.ts notifications-gate.test.ts",
     "test:validators": "yarn build:validators && git ls-files --error-unmatch src/generated-tool-validators.js >/dev/null && git diff --exit-code -- src/generated-tool-validators.js",
     "typecheck": "tsc --noEmit -p tsconfig.npm.json && tsc -p tsconfig.remote.json",
     "watch": "tsc --watch",
     "watch-logs": "NODE_ENV=development mcps-logger --watch"
    },
    "type": "module",
    "types": "./build/index.d.ts",
    "version": "0.0.1-beta.15"
   },
