    "scripts": {
     "build": "rm -rf build && tsc -p tsconfig.npm.json && chmod 755 build/index.js",
     "build:remote": "rm -rf build-remote && tsc -p tsconfig.json --outDir build-remote && chmod 755 build-remote/remote.js",
     "build:vectors": "node --loader ts-node/esm scripts/build-vectors.ts",
     "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --loader ts-node/esm src/index.ts",
     "dev:remote": "node --loader ts-node/esm src/remote.ts",
