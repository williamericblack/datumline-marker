    "scripts": {
     "build": "tsc && chmod 755 build/index.js",
     "build:vectors": "node --loader ts-node/esm scripts/build-vectors.ts",
     "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --loader ts-node/esm src/index.ts",
     "generate": "rm -rf ../../out-compact && node ../generator/bin/openapi-mcp-generator.js --input ../../convert-OA3.yaml --output ../../out-compact --namespace-mode compact --force",
