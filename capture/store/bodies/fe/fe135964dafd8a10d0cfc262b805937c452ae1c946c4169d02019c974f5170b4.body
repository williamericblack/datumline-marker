 "manifest": {
  "_id": "@adenot/mcp-google-search",
  "_rev": "6-bae297467cdcc0cc533b9da45ec2388b",
  "description": "A Model Context Protocol server for Google Search",
  "dist-tags": {
   "latest": "0.3.1"
  },
  "maintainers": [
