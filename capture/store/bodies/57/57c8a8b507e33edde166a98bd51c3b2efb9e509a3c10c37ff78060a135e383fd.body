     "audit:refresh": "rm -f bun.lock && bun install && bun audit",
     "build": "bun run scripts/build.ts",
     "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/eur-lex-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/eur-lex-mcp-server.mcpb",
