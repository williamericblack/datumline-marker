    },
    "_npmVersion": "10.8.2",
    "_resolved": "/tmp/a2657ab70e9021b91d1d7475a21f2642/eventcatalog-mcp-server-1.0.0.tgz",
    "author": {
     "name": "David Boyne"
    },
    "bin": {
     "eventcatalog-mcp-server": "dist/index.js"
    },
    "dependencies": {
     "@modelcontextprotocol/sdk": "^1.6.1",
