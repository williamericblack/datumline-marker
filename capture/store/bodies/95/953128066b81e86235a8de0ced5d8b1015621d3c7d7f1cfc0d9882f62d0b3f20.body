    "_hasShrinkwrap": false,
    "_id": "@eventcatalog/mcp-server@1.0.0",
    "_integrity": "sha512-uZwVRpivUni+1XeMnk795WcwbzWGfI3DibCtpeu2DKFKSiM9SisBVezilHMigP3rKrkz10dxbPF5BeDv/S5cdA==",
    "_nodeVersion": "20.19.1",
    "_npmOperationalInternal": {
     "host": "s3://npm-registry-packages-npm-production",
     "tmp": "tmp/mcp-server_1.0.0_1748860650570_0.16818003982415108"
    },
    "_npmUser": {
