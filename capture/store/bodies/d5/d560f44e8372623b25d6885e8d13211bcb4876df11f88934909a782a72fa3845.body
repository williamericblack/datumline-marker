 "manifest": {
  "_id": "@genkey/keygen-mcp-server",
  "_rev": "5-036e279ca8aad633f3a54cd10585e7ef",
  "description": "MCP Server for Keygen License Management System",
  "dist-tags": {
   "latest": "1.0.4"
