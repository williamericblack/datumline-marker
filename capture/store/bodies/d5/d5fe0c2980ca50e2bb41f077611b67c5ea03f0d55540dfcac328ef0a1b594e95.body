    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "type": "git",
     "url": "git+https://github.com/dearlordylord/huly-mcp.git"
    },
    "scripts": {
     "build": "pnpm build:mcp && pnpm build:cli",
     "build:cli": "pnpm --filter @firfi/huly-cli build",
     "build:mcp": "PKG_VERSION=$(node -p \"require('./package.json').version\") NODE_ENGINE_REQUIREMENT=$(node -p \"require('./package.json').engines.node\") && esbuild src/launcher.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=dist/index.cjs --external:ws \"--define:PKG_VERSION=\\\"$PKG_VERSION\\\"\" \"--define:NODE_ENGINE_REQUIREMENT=\\\"$NODE_ENGINE_REQUIREMENT\\\"\"",
     "capture:effect4-oracle": "pnpm build && node scripts/run-bundled.mjs scripts/effect4-oracle-command.ts capture",
     "certify-packed-artifact": "node scripts/run-bundled.mjs scripts/certify-packed-artifact.ts",
     "certify:api-token": "node scripts/run-bundled.mjs scripts/api-token-certification.ts",
     "check-all": "tsx scripts/run-quality-gate.ts",
     "check-format": "dprint check",
     "circular": "dpdm --no-warning --no-tree --no-progress --exit-code circular:1 --transform 'src/**/*.ts' 'packages/huly-cli/src/**/*.ts'",
     "complexity": "oxlint -c oxlint.complexity.json src packages/huly-cli/src",
     "format": "dprint fmt",
     "integration:cli": "bash scripts/integration_test_cli.sh",
     "integration:cli:full": "bash scripts/integration_test_cli_full.sh",
     "integration:mcp:full": "bash scripts/integration_test_full.sh",
     "integration:tool-scope": "bash scripts/integration_test_tool_scope.sh",
     "lint": "find src packages scripts test -name '*.ts' -print0 | xargs -0 oxlint --deny-warnings && dprint check && jscpd --silent src packages/huly-cli/src",
     "lint:fix": "find src packages scripts test -name '*.ts' -print0 | xargs -0 oxlint --fix && dprint fmt",
     "local-release": "bash scripts/local_release.sh",
     "report-cli-artifact-size": "node scripts/run-bundled.mjs scripts/report-cli-artifact-size.ts",
     "report-cli-parity": "node scripts/run-bundled.mjs scripts/report-cli-parity.ts",
     "report:effect4-oracle-deltas": "node scripts/run-bundled.mjs scripts/report-effect4-oracle-deltas.ts",
     "smoke:http-no-config": "node scripts/smoke-http-no-config.mjs",
     "smoke:stdio-unreachable": "pnpm build:mcp && node scripts/smoke-stdio-unreachable.mjs",
     "start": "node dist/index.cjs",
     "sync-registry-metadata": "node scripts/sync-registry-metadata.mjs",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:watch": "vitest",
     "typecheck": "pnpm typecheck:tsc && pnpm typecheck:effect",
     "typecheck:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning",
     "typecheck:tsc": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit 2>&1 | { grep -E '^(src/|packages/|scripts/|test/|tsconfig\\.json)' && exit 1 || exit 0; }",
     "update-cli-artifact-size": "node scripts/run-bundled.mjs scripts/report-cli-artifact-size.ts --write",
     "update-cli-readme": "node scripts/run-bundled.mjs scripts/update-cli-readme.ts",
     "update-cli-skill": "node scripts/run-bundled.mjs scripts/update-cli-skill.ts",
     "update-readme": "tsx scripts/update-readme-tools.mjs",
     "verify-cli-integration-coverage": "node scripts/run-bundled.mjs scripts/verify-cli-integration-coverage.ts",
     "verify-cli-package-closure": "node scripts/run-bundled.mjs scripts/verify-cli-package-closure.ts",
     "verify-cli-readme": "node scripts/run-bundled.mjs scripts/update-cli-readme.ts --check",
     "verify-cli-skill": "node scripts/run-bundled.mjs scripts/update-cli-skill.ts --check",
     "verify-cli-skill-package": "node scripts/run-bundled.mjs scripts/verify-cli-skill-package.ts",
     "verify-readme": "tsx scripts/update-readme-tools.mjs --check",
     "verify-registry-metadata": "node scripts/sync-registry-metadata.mjs --check",
     "verify-registry-schema": "node scripts/verify-registry-schema.mjs",
     "verify-schema-boundaries": "node scripts/verify-schema-boundaries.mjs",
     "verify-sdk-parity": "node scripts/audit-sdk-parity.mjs",
     "verify-version": "node -e \"const v=require('./package.json').version; const d=require('fs').readFileSync('dist/index.cjs','utf8'); if(!d.includes('\\\"'+v+'\\\"'))throw new Error('dist version mismatch: expected '+v)\"",
     "verify:effect-cohort": "node scripts/verify-effect-cohort.mjs",
     "verify:effect4-oracle": "pnpm build && node scripts/run-bundled.mjs scripts/effect4-oracle-command.ts verify",
     "verify:effect4-oracle:built": "node scripts/run-bundled.mjs scripts/effect4-oracle-command.ts verify"
    },
