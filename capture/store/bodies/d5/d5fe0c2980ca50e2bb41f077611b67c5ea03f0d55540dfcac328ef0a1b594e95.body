     "build": "pnpm build:mcp && pnpm build:cli",
     "build:cli": "pnpm --filter @firfi/huly-cli build",
     "build:mcp": "PKG_VERSION=$(node -p \"require('./package.json').version\") && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:ws \"--define:PKG_VERSION=\\\"$PKG_VERSION\\\"\"",
     "check-all": "pnpm build && pnpm typecheck && pnpm verify-schema-boundaries && pnpm circular && pnpm verify-registry-metadata && pnpm verify-registry-schema && pnpm verify-cli-integration-coverage && pnpm verify-sdk-parity && pnpm verify-readme && pnpm lint && pnpm test:coverage",
     "check-format": "find src packages scripts test -name '*.ts' -print0 | xargs -0 eslint --rule '@effect/dprint: error'",
     "circular": "madge --extensions ts --circular src packages/huly-cli/src",
     "format": "find src packages scripts test -name '*.ts' -print0 | xargs -0 eslint --fix --rule '@effect/dprint: error'",
     "integration:cli": "bash scripts/integration_test_cli.sh",
     "integration:tool-scope": "bash scripts/integration_test_tool_scope.sh",
     "lint": "find src packages scripts test -name '*.ts' -print0 | xargs -0 eslint && jscpd src packages/huly-cli/src",
     "lint:fix": "find src packages scripts test -name '*.ts' -print0 | xargs -0 eslint --fix",
     "local-release": "bash scripts/local_release.sh",
     "smoke:http-no-config": "node scripts/smoke-http-no-config.mjs",
     "smoke:stdio-unreachable": "pnpm build:mcp && node scripts/smoke-stdio-unreachable.mjs",
