     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEUCIF/hl5YzKpLc+MGKJSFJaMNz0bASxXXdc31IwW9ZqHngAiEA0lWA70a9LUJyettXo7a60uI+hhxub0sfzOcrAPLuCVY="
