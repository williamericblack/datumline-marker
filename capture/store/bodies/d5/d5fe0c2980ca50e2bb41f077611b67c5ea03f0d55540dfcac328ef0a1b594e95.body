     "sync-registry-metadata": "node scripts/sync-registry-metadata.mjs",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:watch": "vitest",
     "typecheck": "tsc -p tsconfig.json --noEmit 2>&1 | { grep -E '^(src/|packages/|scripts/|test/)' && exit 1 || exit 0; }",
