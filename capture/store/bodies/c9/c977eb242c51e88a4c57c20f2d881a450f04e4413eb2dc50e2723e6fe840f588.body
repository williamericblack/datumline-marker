 "manifest": {
  "_id": "@geunoh/s3-mcp-server",
  "_rev": "18-2b58fa541554c154a110c334c555a098",
  "description": "MCP Server for accessing S3 bucket",
  "dist-tags": {
   "latest": "1.3.1"
  },
  "keywords": [
   "mcp",
   "s3",
   "aws",
   "server"
  ],
  "license": "MIT",
  "maintainers": [
