  "description": "OpenCode plugin: run the mcp-combiner MCP aggregator via sharedserver and register its endpoint with OpenCode.",
  "dist-tags": {
   "dev": "0.1.0-dev.0",
   "latest": "0.13.4"
  },
  "homepage": "https://github.com/georgeharker/mcp-companion/tree/main/plugins/opencode#readme",
  "keywords": [
   "opencode",
   "opencode-plugin",
   "mcp",
   "mcp-combiner",
