     "inspect:build": "npm run build && npx @modelcontextprotocol/inspector -e MAPBOX_ACCESS_TOKEN=\"$MAPBOX_ACCESS_TOKEN\" -e MCP_DISABLE_LOGGING=true node dist/esm/index.js",
     "inspect:build:tracing": "npm run build && npx @modelcontextprotocol/inspector -e MAPBOX_ACCESS_TOKEN=\"$MAPBOX_ACCESS_TOKEN\" -e OTEL_SERVICE_NAME=mapbox-mcp-server-inspector -e OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 -e MCP_DISABLE_LOGGING=true node dist/esm/index.js",
     "inspect:dev": "npx @modelcontextprotocol/inspector -e MAPBOX_ACCESS_TOKEN=\"$MAPBOX_ACCESS_TOKEN\" -e MCP_DISABLE_LOGGING=true npx -y tsx src/index.ts",
     "inspect:dev:tracing": "npx @modelcontextprotocol/inspector -e MAPBOX_ACCESS_TOKEN=\"$MAPBOX_ACCESS_TOKEN\" -e OTEL_SERVICE_NAME=mapbox-mcp-server-dev -e OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 -e MCP_DISABLE_LOGGING=true npx tsx src/index.ts",
     "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./test/**/*.{ts,tsx}\"",
     "lint:fix": "eslint \"./src/**/*.{ts,tsx}\" \"./test/**/*.{ts,tsx}\" --fix",
     "prepare": "husky && node .husky/setup-hooks.js",
     "spellcheck": "cspell \"*.md\" \"src/**/*.ts\" \"test/**/*.ts\"",
     "sync-manifest": "node scripts/sync-manifest-version.cjs",
     "test": "vitest",
     "test:tracing": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 npm test",
     "tracing:demo": "echo '\u26a0\ufe0f  This demo shows tracing but uses console output - NOT for stdio transport!' && OTEL_EXPORTER_CONSOLE_ENABLED=true npx tsx scripts/tracing-demo.ts",
     "tracing:jaeger:start": "docker run --rm -d --name jaeger -p 16686:16686 -p 14250:14250 -p 4317:4317 -p 4318:4318 jaegertracing/all-in-one:latest",
     "tracing:jaeger:stop": "docker stop jaeger",
     "tracing:test": "OTEL_SERVICE_NAME=mapbox-mcp-server-test npx tsx scripts/test-tracing.ts",
     "tracing:verify": "node -e \"console.log('\ud83d\udd0d Verifying tracing setup with Jaeger...\\nMake sure Jaeger is running: npm run tracing:jaeger:start\\nThen run: npm run inspect:build:tracing\\nCheck traces at: http://localhost:16686')\""
    },
    "tshy": {
     "dialects": [
      "esm",
      "commonjs"
     ],
     "exports": {
      ".": "./src/index.ts"
     },
     "project": "./tsconfig.src.json",
     "selfLink": false
    },
    "type": "module",
    "types": "./dist/commonjs/index.d.ts",
    "version": "0.6.1"
   },
