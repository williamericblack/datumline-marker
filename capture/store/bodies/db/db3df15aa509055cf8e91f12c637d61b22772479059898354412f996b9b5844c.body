    "scripts": {
     "build": "tsc -p tsconfig.build.json",
     "build:bundle": "node scripts/bundle-python.mjs",
     "build:mcpb": "npm run check:versions && npm run build:bundle && node scripts/build-mcpb.mjs",
     "build:npm-bootstrap": "node scripts/build-npm-bootstrap.mjs",
     "build:pypi": "npm run check:versions && npm run build:bundle && uv build --out-dir python/dist",
     "check": "npm run check:versions && npm run typecheck && npm run test:coverage && npm run build && npm run build:bundle && npm run verify:sbom && npm run smoke && npm run smoke:bundle && node scripts/build-mcpb.mjs && npm run verify:mcpb",
     "check:versions": "node scripts/check-versions.mjs",
     "deps:locked": "npm ci --ignore-scripts && npm rebuild esbuild@0.28.1 --ignore-scripts=false",
     "dev": "tsx src/index.ts",
     "prepack": "npm run check:versions && npm run build && npm run build:bundle && npm run verify:sbom",
     "smoke": "node scripts/smoke-stdio.mjs node dist/index.js",
     "smoke:bundle": "node scripts/smoke-stdio.mjs node bundle/discord-mcp.cjs",
     "start": "node dist/index.js",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:watch": "vitest",
     "typecheck": "tsc -p tsconfig.json --noEmit",
     "verify:mcpb": "node scripts/verify-mcpb.mjs",
     "verify:sbom": "node scripts/verify-sbom.mjs"
    },
