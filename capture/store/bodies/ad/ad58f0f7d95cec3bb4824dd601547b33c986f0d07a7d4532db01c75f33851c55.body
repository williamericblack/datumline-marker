    "name": "@heroui/native-mcp",
    "packageManager": "pnpm@10.17.0",
    "prettier": "@heroui/config/prettier",
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "directory": "apps/native-mcp",
     "type": "git",
     "url": "git+https://github.com/heroui-inc/heroui-mcp.git"
    },
    "scripts": {
     "build": "tsup && chmod +x dist/stdio.js",
     "build:api": "wrangler deploy --dry-run --outdir dist-api",
     "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path . --tag-prefix native-mcp-v",
     "clean": "rm -rf dist dist-api",
     "deploy:api": "wrangler deploy src/api.ts --minify",
     "deploy:api:production": "wrangler deploy src/api.ts --env production",
     "deploy:api:staging": "wrangler deploy src/api.ts --env staging",
     "dev": "npm run dev:api",
     "dev:api": "dotenv -- wrangler dev src/api.ts --env development --port 8788",
     "dev:stdio": "NODE_ENV=development tsx --watch src/mcp/stdio.ts",
     "extract:dev": "./scripts/extract-dev.sh both",
     "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
     "inspect": "NODE_ENV=development CLIENT_PORT=6275 SERVER_PORT=6278 npx @modelcontextprotocol/inspector -e HEROUI_NATIVE_API_URL=http://localhost:8788 tsx src/mcp/stdio.ts",
     "lint": "eslint src/**/*.ts",
     "lint:fix": "eslint src/**/*.ts --fix",
     "mcp:stdio": "NODE_ENV=development tsx src/mcp/stdio.ts",
     "postpublish": "node scripts/restore-package.mjs",
     "prepublishOnly": "pnpm build && node scripts/resolve-workspace-deps.mjs",
     "release": "bumpp --execute='pnpm run changelog' --all --tag='native-mcp-v%s' --commit='chore(native-mcp): release v%s'",
     "release:check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
     "test": "vitest run",
     "test:api": "node test-api.mjs",
     "test:api:production": "node test-api.mjs --url https://native-mcp-api.heroui.com",
     "test:api:staging": "node test-api.mjs --url https://staging-native-mcp-api.heroui.com",
     "test:ui": "vitest --ui",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "version": "1.1.0"
   },
