    "scripts": {
     "build": "node -e \"const fs=require('fs'); const path=require('path'); const copyDir = (src, dest) => { if (!fs.existsSync(dest)) fs.mkdirSync(dest, { recursive: true }); const entries = fs.readdirSync(src, { withFileTypes: true }); for(const entry of entries) { const srcPath = path.join(src, entry.name); const destPath = path.join(dest, entry.name); if (entry.isDirectory()) { copyDir(srcPath, destPath); } else if (entry.name.endsWith('.mjs')) { fs.copyFileSync(srcPath, destPath.replace('.mjs', '.js')); } } }; copyDir('src', 'dist');\"",
     "prepare": "npm run build",
     "start": "node dist/server.js"
    },
