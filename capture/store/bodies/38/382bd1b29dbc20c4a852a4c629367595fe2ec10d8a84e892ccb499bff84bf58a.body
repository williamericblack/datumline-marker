 "manifest": {
  "_id": "@gravity8/dillie-mcp",
  "_rev": "16-4058b2de5f04e4177a83b05f024fe3c1",
  "description": "dillie \ud504\ub85c\uc81d\ud2b8/\ud0dc\uc2a4\ud06c\ub97c MCP \ub3c4\uad6c\ub85c \ub178\ucd9c\ud558\ub294 Model Context Protocol \uc11c\ubc84",
