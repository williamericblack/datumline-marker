    "gitHead": "1b9ef26b36181efd1dc37e8c722fe72538093a17",
    "homepage": "https://github.com/mongodb-js/mongodb-mcp-server",
    "license": "Apache-2.0",
    "main": "./dist/cjs/lib.js",
    "maintainers": [
     {
      "email": "[redacted-email:50da2bc784b4]",
      "name": "himanshusinghs"
     }
    ],
    "mcpName": "io.github.mongodb-js/mongodb-mcp-server",
    "name": "@himanshusinghs/mongodb-mcp-server",
    "optionalDependencies": {
     "@mongodb-js/atlas-local": "^1.1.0",
     "kerberos": "^2.2.2"
    },
    "overrides": {
     "kerberos": "^2.2.2",
     "mongodb": "^6.21.0"
    },
    "packageManager": "pnpm@10.23.0",
    "pnpm": {
     "overrides": {
      "kerberos": "^2.2.2",
      "mongodb": "^6.21.0"
     }
    },
    "publishConfig": {
     "access": "public"
    },
    "repository": {
     "url": "git+https://github.com/mongodb-js/mongodb-mcp-server.git"
    },
    "scripts": {
     "atlas:cleanup": "vitest --project atlas-cleanup",
     "build": "concurrently \"pnpm run build:esm\" \"pnpm run build:cjs\" && pnpm run build:universal-package",
     "build:cjs": "tsc --project tsconfig.cjs.json",
     "build:esm": "tsc --project tsconfig.esm.json && chmod +x dist/esm/index.js",
     "build:universal-package": "tsx scripts/createUniversalPackage.ts",
     "build:update-package-version": "tsx scripts/updatePackageVersion.ts",
     "check": "concurrently \"pnpm run build\" \"pnpm run check:types\" \"pnpm run check:lint\" \"pnpm run check:format\" \"pnpm run check:dependencies\"",
     "check:dependencies": "knip --strict",
     "check:format": "prettier -c .",
     "check:lint": "eslint .",
     "check:types": "tsc --noEmit --project tsconfig.json",
     "fix": "pnpm run fix:lint && pnpm run reformat",
     "fix:lint": "eslint . --fix",
     "generate": "pnpm run generate:api && pnpm run generate:arguments && pnpm run generate:ui",
     "generate:api": "./scripts/generate.sh",
     "generate:arguments": "tsx --tsconfig scripts/generate/tsconfig.json scripts/generate/index.ts",
     "generate:ui": "tsx --tsconfig scripts/generate/tsconfig.json scripts/generate/generateUI.ts",
     "inspect": "pnpm run build && mcp-inspector -- dist/esm/index.js",
     "prepare": "husky && pnpm run build",
     "pretest": "pnpm run build",
     "prettier": "prettier",
     "reformat": "prettier --write .",
     "start": "node dist/index.js --transport http --loggers 'stderr, mcp' --previewFeatures search",
     "start:stdio": "node dist/index.js --transport stdio --loggers 'stderr, mcp' --previewFeatures search",
     "test": "vitest --project eslint-rules --project unit-and-integration --coverage --run",
     "test:accuracy": "sh ./scripts/accuracy/runAccuracyTests.sh",
     "test:browser": "pnpm --filter browser test",
     "test:local": "SKIP_ATLAS_TESTS=true SKIP_ATLAS_LOCAL_TESTS=true pnpm run test",
     "test:long-running-tests": "vitest --project long-running-tests --coverage"
    },
    "type": "module",
    "types": "./dist/cjs/lib.d.ts",
    "version": "1.5.1-prerelease.6"
   },
