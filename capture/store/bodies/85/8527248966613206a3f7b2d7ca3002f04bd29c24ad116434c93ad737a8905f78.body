     "directory": "packages/servers/yandex-wiki",
     "type": "git",
     "url": "git+https://github.com/FractalizeR/mcp_servers.git"
    },
    "scripts": {
     "build": "tsc -b && tsc-alias && npm run build:bundle",
     "build:bundle": "tsx ../scripts/increment-build.ts && tsup",
     "build:mcpb": "npm run build && tsx ../scripts/build-mcpb.ts",
     "clean": "rimraf dist",
     "cpd": "jscpd src",
     "cpd:quiet": "jscpd src --silent",
     "cpd:report": "jscpd src --reporters html,console",
     "depcruise": "depcruise src -c ../../../.dependency-cruiser.cjs",
     "dev": "npm run build && node dist/yandex-wiki.bundle.cjs",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "generate:index": "tsx scripts/generate-tool-index.ts",
     "lint": "eslint src --ext .ts",
     "lint:fix": "eslint src --ext .ts --fix",
     "lint:quiet": "eslint src --ext .ts --quiet",
     "mcp:connect": "npm run build && node dist/cli/bin/mcp-connect.js connect",
     "mcp:disconnect": "npm run build && node dist/cli/bin/mcp-connect.js disconnect",
     "mcp:list": "npm run build && node dist/cli/bin/mcp-connect.js list",
     "mcp:status": "npm run build && node dist/cli/bin/mcp-connect.js status",
     "prebuild": "npm run generate:index",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:quiet": "vitest run --reporter=dot --silent",
     "test:smoke": "vitest run tests/smoke",
     "test:smoke:server": "tsx scripts/smoke-test-server.ts",
     "test:verbose": "vitest run --reporter=verbose",
     "test:watch": "vitest watch",
     "typecheck": "tsc --noEmit",
     "validate": "npm run lint && npm run typecheck && npm run test && npm run test:smoke && npm run test:smoke:server && npm run cpd && npm run depcruise && npm run validate:docs && npm run validate:tools",
     "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
     "validate:quiet": "npm run lint:quiet && npm run typecheck && npm run test:quiet && npm run test:smoke && npm run test:smoke:server && npm run cpd:quiet && npm run depcruise && npm run validate:docs && npm run validate:tools",
     "validate:tools": "tsx scripts/validate-tool-registration.ts"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "1.5.1"
   },
