    },
    "scripts": {
     "build": "tsc -b && tsc-alias && npm run build:bundle",
     "build:bundle": "tsup",
     "build:mcpb": "npm run build && tsx ../scripts/increment-build.ts && tsx ../scripts/build-mcpb.ts",
     "clean": "rimraf dist",
     "cpd": "jscpd src",
     "cpd:quiet": "jscpd src --silent",
     "cpd:report": "jscpd src --reporters html,console",
     "depcruise": "cd ../../.. && depcruise packages/servers/yandex-wiki/src -c .dependency-cruiser.cjs",
     "dev": "npm run build && node dist/yandex-wiki.bundle.cjs",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
     "lint": "eslint src scripts --ext .ts --max-warnings=6",
     "lint:fix": "eslint src scripts --ext .ts --fix",
     "lint:quiet": "npm run lint -- --quiet",
     "mcp:connect": "npm run build && node dist/cli/bin/mcp-connect.js connect",
     "mcp:disconnect": "npm run build && node dist/cli/bin/mcp-connect.js disconnect",
     "mcp:list": "npm run build && node dist/cli/bin/mcp-connect.js list",
     "mcp:status": "npm run build && node dist/cli/bin/mcp-connect.js status",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:quiet": "vitest run --reporter=dot --silent",
     "test:raw-wire": "tsx scripts/raw-wire-test.ts",
     "test:smoke": "vitest run tests/smoke",
     "test:smoke:server": "tsx scripts/smoke-test-server.ts",
     "test:verbose": "vitest run --reporter=verbose",
     "test:watch": "vitest watch",
     "tools:batch": "mcp-dev batch --server-name fractalizer_mcp_yandex_wiki --package-dir .",
     "tools:call": "mcp-dev call --server-name fractalizer_mcp_yandex_wiki --package-dir .",
     "tools:list": "mcp-dev list --server-name fractalizer_mcp_yandex_wiki --package-dir . --json",
     "typecheck": "tsc --noEmit",
     "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
     "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
     "validate": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm run test && npm run test:smoke && npm run test:smoke:server && npm run test:raw-wire && npm run cpd && npm run depcruise && npm run validate:docs && npm run validate:tools",
     "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
