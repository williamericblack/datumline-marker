     "shasum": "1f2e5184cf4e5b2a7a45db5fb6a14ea17e14c217",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEUCIHeUJvqBjko+iLGQ+gQdoLYufaixdULATC4Yp+TC3SrcAiEA58jgxVryT4Ub+g7c5j0pj1NbA8S+4hua2niAd3pR8RQ="
      }
