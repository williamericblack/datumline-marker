 "manifest": {
  "_id": "@nuxtjs/mcp-toolkit",
  "_rev": "38-57c7dc5a8b6bdc24fea046ceaaff1c7d",
  "author": "Hugo Richard <[redacted-email:6343ea0cc00c]>",
  "bugs": {
   "url": "https://github.com/nuxt-modules/mcp-toolkit/issues"
  },
  "description": "Create MCP servers directly in your Nuxt application. Define tools, resources, and prompts with a simple and intuitive API.",
  "dist-tags": {
   "latest": "0.21.0"
  },
  "homepage": "https://mcp-toolkit.nuxt.dev",
  "license": "MIT",
  "maintainers": [
   {
    "email": "[redacted-email:03c3557ac74a]",
    "name": "pi0"
   },
   {
    "email": "[redacted-email:db5872d483d8]",
