  "name": "@demitycho/pg-vector-mcp",
  "readme": "# pg-vector-mcp\n\nUsage\n\n\nmcp_servers:\n  scientific_db_rag:\n    server_type: stdio\n    command: npx\n    args:\n      - \"@demitycho/pg-vector-mcp@1.0.0\"\n      - \"OPENAI_KEY\"\n      - \"SUPABASE_URL\" // Like https://wbjewnwnzhorjmdvxyrd.supabase.co\n      - \"SUPABASE_KEY\" // Like ey...\n      - \"ACCOUNT_ID\"   // Like 001-rootoflife - Corresponding to the account's agent\n\nTest using inspector:\n\n```\nnpx @modelcontextprotocol/inspector node mcp-server.js OPENAI_KEY SUPABASE_URL SUPABASE_KEY ACCOUNT_ID\n```",
  "readmeFilename": "README.md",
