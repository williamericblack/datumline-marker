    },
    "scripts": {
     "build": "npm run build:http",
     "build:http": "npx @smithery/cli build",
     "build:stdio": "tsc && shx chmod +x dist/*.js",
     "changelog:init": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
     "check": "biome check --apply .",
     "commit": "git-cz",
