    },
    "scripts": {
     "build": "rimraf build && tsc && npm run copy-templates",
     "copy-templates": "mkdir -p build/init/templates/markdown && cp -r src/init/templates/markdown/* build/init/templates/markdown/",
     "format": "prettier --write --ignore-unknown .",
     "go": "node --loader ts-node/esm src/index.ts",
     "lint": "npm-run-all --sequential lint:*",
