     "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\" && esbuild src/serverless.ts --bundle --platform=node --format=esm --outfile=dist/serverless.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
     "build:dev": "tsx --watch src/index.ts",
     "build:watch": "tsc --watch",
     "coverage": "vitest run --coverage",
     "inspector": "pnpm build && DANGEROUSLY_OMIT_AUTH=true mcp-inspector node dist/index.js",
     "inspector-http": "pnpm build && (TRANSPORT=http node dist/index.js &) && sleep 2 && DANGEROUSLY_OMIT_AUTH=true mcp-inspector http://localhost:3000/mcp",
     "mcp:http": "pnpm build && TRANSPORT=http node dist/index.js",
     "mcp:stdio": "pnpm build && TRANSPORT=stdio node dist/index.js",
     "release:dry-run": "semantic-release --dry-run",
     "semantic-release": "semantic-release",
     "test": "vitest",
     "test:watch": "vitest --watch"
