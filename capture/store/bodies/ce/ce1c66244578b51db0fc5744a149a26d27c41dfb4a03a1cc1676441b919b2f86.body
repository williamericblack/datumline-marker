     "build": "wireit",
     "bundle": "wireit",
     "copy-assets": "wireit",
     "dev": "node --enable-source-maps ./dist/index.js",
     "extract-components": "wireit",
     "inspect": "npx @modelcontextprotocol/inspector ./dist/index.js",
     "prepublishOnly": "pnpm run build"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "39.27.0--canary.2213.25074513030.0",
    "wireit": {
     "build": {
      "dependencies": [
       "copy-assets"
      ]
     },
     "bundle": {
      "command": "node ./scripts/bundle.mjs",
      "dependencies": [
       "extract-components"
      ],
      "files": [
       "src/**",
       "scripts/bundle.mjs",
       "tsconfig.json",
       "package.json"
      ],
      "output": [
       "dist/index.js",
       "dist/index.js.map"
      ]
     },
