    "version": "39.39.1",
    "wireit": {
     "build": {
      "dependencies": [
       "copy-assets"
      ]
     },
     "bundle": {
      "command": "node ./scripts/bundle.mjs",
      "dependencies": [
       "extract-components"
      ],
      "files": [
       "src/**",
       "scripts/bundle.mjs",
       "tsconfig.json",
       "package.json"
      ],
      "output": [
       "dist/index.js",
       "dist/index.js.map"
      ]
     },
