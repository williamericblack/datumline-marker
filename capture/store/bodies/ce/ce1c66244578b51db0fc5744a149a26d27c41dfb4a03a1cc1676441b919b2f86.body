     "build": {
      "dependencies": [
       "copy-assets"
      ]
     },
     "bundle": {
      "command": "node ./scripts/bundle.mjs",
      "dependencies": [
       "extract-components"
      ],
      "files": [
       "src/**",
       "scripts/bundle.mjs",
       "tsconfig.json",
       "package.json"
      ],
