    "name": "@infineon/design-system-mcp",
    "peerDependencies": {
     "@infineon/infineon-design-system-angular": "39.47.0",
     "@infineon/infineon-design-system-react": "39.47.0",
     "@infineon/infineon-design-system-stencil": "39.47.0",
     "@infineon/infineon-design-system-vue": "39.47.0"
    },
    "peerDependenciesMeta": {
     "@infineon/infineon-design-system-angular": {
      "optional": true
     },
     "@infineon/infineon-design-system-react": {
      "optional": true
     },
     "@infineon/infineon-design-system-stencil": {
      "optional": true
     },
     "@infineon/infineon-design-system-vue": {
      "optional": true
     }
    },
    "publishConfig": {
     "access": "public"
    },
    "scripts": {
     "build": "wireit",
     "bundle": "wireit",
     "copy-assets": "wireit",
     "dev": "node --enable-source-maps ./dist/index.js",
     "extract-components": "wireit",
     "inspect": "npx @modelcontextprotocol/inspector ./dist/index.js",
     "prepublishOnly": "pnpm run build"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "39.47.0",
    "wireit": {
     "build": {
      "dependencies": [
       "copy-assets"
      ]
     },
     "bundle": {
      "command": "node ./scripts/bundle.mjs",
      "dependencies": [
       "extract-components"
      ],
      "files": [
       "src/**",
       "scripts/bundle.mjs",
       "tsconfig.json",
       "package.json"
      ],
      "output": [
       "dist/index.js",
       "dist/index.js.map"
      ]
     },
     "copy-assets": {
      "command": "node ./scripts/copy-assets.mjs",
      "dependencies": [
       "bundle",
       "ensure-docs"
      ],
      "files": [
       "assets/**",
       "scripts/copy-assets.mjs"
      ],
      "output": [
       "dist/assets/**"
      ]
     },
     "ensure-docs": {
      "command": "node ./scripts/ensure-docs.mjs",
      "dependencies": [
       "../components:build"
      ],
      "files": [
       "../components/stencil.config.ts",
       "scripts/ensure-docs.mjs"
      ],
      "output": [
       "assets/docs.json",
       "assets/docs.d.ts"
      ]
     },
     "extract-components": {
      "command": "node ./scripts/extract-components.mjs",
      "dependencies": [
       "../dds-tooling:build",
       "ensure-docs"
      ],
      "files": [
       "scripts/extract-components.mjs",
       "../components/src/storybook/stories/**"
      ],
      "output": [
       "assets/examples/**"
      ]
     }
    }
   },
