     "build": "wireit",
     "bundle": "wireit",
     "copy-assets": "wireit",
     "dev": "node --enable-source-maps ./dist/index.js",
     "extract-components": "wireit",
     "inspect": "npx @modelcontextprotocol/inspector ./dist/index.js",
     "prepublishOnly": "pnpm run build"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "40.3.2--canary.2494.33520860692.0",
    "wireit": {
     "build": {
      "dependencies": [
       "copy-assets"
      ]
     },
     "bundle": {
      "command": "node ./scripts/bundle.mjs",
      "dependencies": [
       "extract-components"
      ],
      "files": [
       "src/**",
       "scripts/bundle.mjs",
       "tsconfig.json",
       "package.json"
      ],
      "output": [
       "dist/index.js",
       "dist/index.js.map"
      ]
     },
     "copy-assets": {
      "command": "node ./scripts/copy-assets.mjs",
      "dependencies": [
       "bundle",
       "ensure-docs"
      ],
      "files": [
       "assets/**",
       "scripts/copy-assets.mjs"
      ],
      "output": [
       "dist/assets/**"
      ]
     },
     "ensure-docs": {
      "command": "node ./scripts/ensure-docs.mjs",
      "dependencies": [
       "../components:build"
      ],
      "files": [
       "../components/stencil.config.ts",
       "scripts/ensure-docs.mjs"
      ],
      "output": [
       "assets/docs.json",
       "assets/docs.d.ts"
      ]
     },
     "extract-components": {
      "command": "node ./scripts/extract-components.mjs",
      "dependencies": [
       "../dds-tooling:build",
       "ensure-docs"
      ],
      "files": [
       "scripts/extract-components.mjs",
       "../components/src/storybook/stories/**"
      ],
      "output": [
       "assets/examples/**"
      ]
     }
    }
   },
