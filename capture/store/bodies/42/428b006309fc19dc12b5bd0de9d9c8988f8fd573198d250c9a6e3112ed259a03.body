 "manifest": {
  "_id": "@maind-dev/mcp-bridge",
  "_rev": "65-e9f3cfd016d6aaf132ae14aa1dfc75c1",
  "description": "Local MCP bridge for maind.dev \u2014 wraps any MCP-compatible client (Claude Code, Cursor, Windsurf) and pins your API key to a single device via the maind device authorization flow.",
  "dist-tags": {
   "latest": "0.67.0"
  },
  "keywords": [
   "mcp",
   "model-context-protocol",
   "maind",
   "bridge",
   "device-binding"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "maintainers": [
