     "build": "tsup",
     "build:fast": "tsup src/index.ts src/suggest/scoring.ts src/suggest/selection-tools.ts src/render-helpers.ts --format esm",
     "bundle": "bash scripts/bundle.sh",
     "check:all": "pnpm format:check && pnpm check:deadcode && pnpm check:duplication && pnpm check:deps && pnpm test",
     "check:deadcode": "knip",
     "check:deps": "depcheck --ignores='jsdom,@anthropic-ai/mcpb,@lezer/lr'",
     "check:duplication": "jscpd ./src",
     "check:triggers": "node scripts/project-triggers.mjs --check",
     "dev": "tsup src/index.ts src/suggest/scoring.ts src/suggest/selection-tools.ts src/render-helpers.ts --format esm --dts --watch",
