    "repository": {
     "type": "git",
     "url": "git+https://github.com/diagrammo/dgmo-mcp.git"
    },
    "scripts": {
     "build": "tsup",
     "build:fast": "tsup src/index.ts src/suggest/scoring.ts src/suggest/selection-tools.ts src/render-helpers.ts --format esm",
     "bundle": "bash scripts/bundle.sh",
     "check:all": "pnpm format:check && pnpm check:deadcode && pnpm check:duplication && pnpm check:deps && pnpm test",
     "check:deadcode": "knip",
     "check:deps": "depcheck --ignores='jsdom,@anthropic-ai/mcpb,@lezer/lr'",
     "check:duplication": "jscpd ./src",
     "check:triggers": "node scripts/project-triggers.mjs --check",
     "dev": "tsup src/index.ts src/suggest/scoring.ts src/suggest/selection-tools.ts src/render-helpers.ts --format esm --dts --watch",
     "format": "prettier --write .",
     "format:check": "prettier --check .",
     "lint": "eslint .",
     "lint:fix": "eslint . --fix",
     "prepack": "node scripts/prepack-mcp.mjs",
     "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
     "project:triggers": "node scripts/project-triggers.mjs",
     "studio": "pnpm -C ../dgmo build && node tools/guidance-studio/use-local-dgmo.mjs && pnpm build && node tools/guidance-studio/dump-registry.mjs && node tools/guidance-studio/build-gallery.mjs && { if command -v claim-port >/dev/null 2>&1; then claim-port 4347 || { [ $? -eq 3 ] || exit 1; exit 0; }; fi; vite tools/guidance-studio --port 4347 --strictPort; }",
     "studio:npm": "node tools/guidance-studio/dump-registry.mjs && pnpm build && node tools/guidance-studio/build-gallery.mjs && { if command -v claim-port >/dev/null 2>&1; then claim-port 4347 || { [ $? -eq 3 ] || exit 1; exit 0; }; fi; vite tools/guidance-studio --port 4347 --strictPort; }",
     "test": "vitest run",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.28.2"
   },
