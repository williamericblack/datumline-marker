    "mcpName": "io.github.diagrammo/dgmo-mcp",
    "name": "@diagrammo/dgmo-mcp",
    "repository": {
     "type": "git",
     "url": "git+https://github.com/diagrammo/dgmo-mcp.git"
    },
    "scripts": {
     "build": "tsup src/index.ts src/suggest/scoring.ts src/render-helpers.ts --format esm --dts",
     "build:fast": "tsup src/index.ts src/suggest/scoring.ts src/render-helpers.ts --format esm",
     "bundle": "bash scripts/bundle.sh",
     "check:all": "pnpm check:deadcode && pnpm check:duplication && pnpm check:deps && pnpm test",
     "check:deadcode": "knip",
     "check:deps": "depcheck --ignores='jsdom,@anthropic-ai/mcpb,@lezer/lr'",
     "check:duplication": "jscpd ./src",
     "check:triggers": "node scripts/project-triggers.mjs --check",
     "dev": "tsup src/index.ts src/suggest/scoring.ts src/render-helpers.ts --format esm --dts --watch",
     "format": "prettier --write .",
     "format:check": "prettier --check .",
     "lint": "eslint .",
     "lint:fix": "eslint . --fix",
     "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
     "project:triggers": "node scripts/project-triggers.mjs",
     "studio": "pnpm -C ../dgmo build && node tools/guidance-studio/use-local-dgmo.mjs && pnpm build && node tools/guidance-studio/dump-registry.mjs && node tools/guidance-studio/build-gallery.mjs && vite tools/guidance-studio",
     "studio:npm": "node tools/guidance-studio/dump-registry.mjs && pnpm build && node tools/guidance-studio/build-gallery.mjs && vite tools/guidance-studio",
     "test": "vitest run",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.10.0"
   },
