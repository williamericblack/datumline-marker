 "manifest": {
  "_id": "@kalelaufa/github-mcp-server",
  "_rev": "3-577acddcacb7cc4030a0faf13892040f",
  "description": "Production-ready GitHub MCP Server with full GitHub API coverage",
  "dist-tags": {
