     "url": "https://github.com/bgx4k3p/huly-mcp-server/issues"
    },
    "dependencies": {
     "@hcengineering/api-client": "^0.7.3",
     "@hcengineering/chunter": "^0.7.0",
     "@hcengineering/core": "^0.7.4",
