 "manifest": {
  "_id": "@angiejones/mcp-selenium",
  "_rev": "21-e89abca1d37142d484fefb749b413a65",
  "description": "Selenium WebDriver MCP Server",
  "dist-tags": {
   "latest": "0.2.3"
  },
  "keywords": [],
