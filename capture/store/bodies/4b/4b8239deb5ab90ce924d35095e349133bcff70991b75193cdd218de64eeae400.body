 "manifest": {
  "_id": "@assistant-ui/mcp-docs-server",
  "_rev": "45-38f55acb65c93dcd7cfa0be0a0b1d0ad",
  "author": "AgentbaseAI Inc.",
  "bugs": {
   "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "description": "Stdio proxy for the hosted assistant-ui documentation MCP server",
  "dist-tags": {
   "latest": "0.3.1"
  },
  "homepage": "https://www.assistant-ui.com/",
  "keywords": [
   "mcp",
   "model-context-protocol",
   "assistant-ui",
   "documentation",
   "ai",
