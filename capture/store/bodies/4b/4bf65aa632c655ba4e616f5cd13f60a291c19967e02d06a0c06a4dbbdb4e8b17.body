     "prepublish:changelog": "claude -p --model haiku --allowedTools Bash,Edit,Read,Glob,Grep -- 'Review all git commits since the last version tag (use git log and git diff). Summarize changes into @CHANGELOG.md following the existing format, update the @README.md if needed. Bump the version in package.json, manifest.json, server.json, and src/index.ts.'"
    },
    "type": "module",
    "version": "1.6.6"
   }
  }
 },
