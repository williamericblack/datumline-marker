    "repository": {
     "type": "git",
     "url": "git+https://github.com/leonio/kern-ux-mcp.git"
    },
    "scripts": {
     "build": "npm run clean && tsc -p tsconfig.build.json && node tools/manifest/copy-manifest.mjs && echo 'Version injected by CI'",
     "build:ci": "npm run clean && tsc -p tsconfig.build.json && node tools/manifest/copy-manifest.mjs",
     "build:watch": "tsc -p tsconfig.build.json --watch",
     "check-version": "dotnet-gitversion /version",
     "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
     "dev": "tsx src/index.ts",
     "generate-manifest": "tsx tools/manifest/build-manifest.ts",
     "lint": "biome lint .",
     "loop:full": "npm run generate-manifest && pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1 -WatchTests -WatchBuild -OpenSample -DebugMcp",
     "loop:start": "npm run generate-manifest && pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1",
     "loop:stop": "pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1 -Stop",
     "pack:inspect": "npm run build:ci && npm run sbom:generate && npm pack --dry-run",
     "pack:release": "npm run build:ci && npm run sbom:generate && npm pack",
     "pre-commit": "npm run lint && npm run check-version",
     "prebuild": "npm run generate-manifest",
     "sample:dev": "npm --prefix samples/basic-layout run dev",
     "sbom:generate": "syft scan dir:. --output cyclonedx-json=sbom.cyclonedx.json",
     "scan:vulns": "npm run sbom:generate && grype sbom:sbom.cyclonedx.json",
     "scan:vulns:high": "npm run sbom:generate && grype sbom:sbom.cyclonedx.json --fail-on high",
     "start": "node dist/index.js",
     "test": "vitest run",
     "test:watch": "vitest",
     "validate-guidance-overlay": "tsx tools/manifest/validate-guidance-overlay.ts",
     "version:json": "dotnet-gitversion /output json"
    },
    "type": "module",
    "version": "1.1.0-5"
   },
