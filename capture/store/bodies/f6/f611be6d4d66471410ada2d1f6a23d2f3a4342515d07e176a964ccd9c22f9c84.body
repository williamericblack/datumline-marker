     "type": "git",
     "url": "git+https://github.com/nielspeter/sonarlint-mcp-server.git"
    },
    "scripts": {
     "build": "tsc",
     "dev": "tsx watch src/index.ts",
     "docs:rules": "node scripts/generate-rules-doc.mjs",
     "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
     "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
     "inspect": "mcp-inspector dist/index.js",
     "lint": "eslint src/ tests/",
     "lint:fix": "eslint src/ tests/ --fix",
     "postinstall": "bash scripts/setup-sonarlint.sh",
     "prepare": "npm run build",
     "release": "standard-version",
     "release:major": "standard-version --release-as major",
     "release:minor": "standard-version --release-as minor",
     "release:patch": "standard-version --release-as patch",
     "setup": "bash scripts/setup-sonarlint.sh",
     "start": "node dist/index.js",
     "test": "vitest",
     "test:coverage": "vitest run --coverage",
     "test:e2e": "vitest run tests/e2e",
     "test:integration": "vitest run tests/integration",
     "test:run": "vitest run",
     "test:ui": "vitest --ui",
     "test:unit": "vitest run tests/unit"
    },
