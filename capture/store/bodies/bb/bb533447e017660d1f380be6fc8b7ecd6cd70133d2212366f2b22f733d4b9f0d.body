    "name": "@cognigy/mcp-server",
    "scripts": {
     "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npx tsc && cp -r src/resources dist/resources && if [ -d assets ]; then cp -r assets dist/assets; fi",
     "cl:preview": "conventional-changelog -p conventionalcommits -u",
     "dev": "tsx watch src/index.ts",
     "lint": "eslint src --ext .ts",
     "mcpb:pack": "npm run build && npx @anthropic-ai/mcpb pack",
     "prepublishOnly": "npm run build",
     "prettier:check": "prettier --check",
     "prettier:write": "prettier --write",
     "setup": "bash scripts/setup.sh",
     "start": "node dist/index.js",
     "start:local": "bash scripts/run-local-mcp.sh",
     "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
     "test-connection": "bash scripts/test-connection.sh",
     "test:init-local": "bash scripts/test-local-init.sh"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.2.17"
   },
