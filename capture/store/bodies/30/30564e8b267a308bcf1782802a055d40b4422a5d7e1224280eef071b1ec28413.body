  },
  "description": "MCP server enabling persistent memory for Claude through a local knowledge graph",
  "dist-tags": {
   "latest": "1.0.7"
  },
  "homepage": "https://github.com/itseasy21/mcp-knowledge-graph",
  "license": "MIT",
  "maintainers": [
