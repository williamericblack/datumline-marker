     "integrity": "sha512-GA4TSihGhCZ9sZBMK/8BRUrdrf5k5l4q961fvhYzb58BcXMSAMz8mX9WkvzBRkU1B2WzCqWDJN1TCbVEjbM5LQ==",
     "shasum": "c39b560c9bbf58463eb6f0e88509cab93e19bd10",
     "signatures": [
