    "scripts": {
     "build": "npm run build:programmatic",
     "build:programmatic": "npm run clean:programmatic && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
     "clean:programmatic": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
     "prepack": "npm run build:programmatic",
     "test": "npm run typecheck && vitest run",
     "test:conformance": "bash conformance/run.sh",
     "test:coverage": "vitest run --coverage",
     "test:host-conformance": "node qualification/run-plugin-host-conformance.mjs",
     "test:oauth": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --import tsx --test --test-concurrency=1 mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
     "test:oauth-provider": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory node --import tsx --test mcp-oauth-provider.test.ts",
     "test:package": "node --import tsx __tests__/packed-package.ts",
     "test:watch": "vitest",
     "typecheck": "tsc --noEmit"
    },
