 "manifest": {
  "_id": "@cotestdev/mcp_playwright",
  "_rev": "57-d1e3f870196b33c857eb4b55a4c957fa",
  "description": "Playwright MCP (Model Context Protocol) tools for browser automation",
  "dist-tags": {
   "latest": "0.0.60"
  },
  "keywords": [
   "playwright",
   "mcp",
   "browser-automation",
