 "manifest": {
  "_id": "@flowboardlabs/mcp-server",
  "_rev": "17-ce4de0f6b6a566e548626c30d25527de",
  "description": "FlowBoard MCP Server \u2014 lets AI tools manage projects, tasks, ideas, and releases",
