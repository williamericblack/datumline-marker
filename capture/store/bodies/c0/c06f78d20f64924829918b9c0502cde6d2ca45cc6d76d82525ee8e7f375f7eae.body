 "manifest": {
  "_id": "@centia-io/mcp-server",
  "_rev": "19-164d7bde5d36942e4feb7498dcaeac93",
  "description": "Centia MCP Server",
  "dist-tags": {
   "latest": "1.0.20"
  },
  "keywords": [],
