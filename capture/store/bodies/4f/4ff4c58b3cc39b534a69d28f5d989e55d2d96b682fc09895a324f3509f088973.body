     "start:sse": "cross-env NODE_ENV=production node dist/server/sse.js",
     "start:stdio": "cross-env NODE_ENV=production node dist/server/stdio.js",
     "test": "vitest run",
     "typecheck": "tsc --noEmit"
    },
