    "scripts": {
     "build": "pnpm run build:server && pnpm run build:web && pnpm run build:mcp-welcome",
     "build:mcp-welcome": "VITE_BUILD_TARGET=mcp-welcome vite build",
     "build:server": "tsc -p tsconfig.server.json",
     "build:web": "vite build",
     "clean": "rimraf dist",
     "dev": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/streamableHttp.js",
     "dev:json": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/streamableHttp.js --json",
     "dev:sse": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/sse.js",
     "dev:stdio": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/stdio.js",
     "dev:watch": "concurrently \"tsc -p tsconfig.server.json --watch\" \"vite build --watch\" \"nodemon dist/server/streamableHttp.js\"",
