    "name": "@gojasper/mcp-server",
    "scripts": {
     "build": "npm run clean && npm run build:local && npm run build:remote && npm run dxt:pack",
     "build:local": "tsc -p tsconfig.local.json && shx cp package.json dist/ && shx chmod +x dist/local/local/index.js",
     "build:remote": "tsc -p tsconfig.remote.json && shx cp package.json dist/ && shx chmod +x dist/remote/remote/index.js",
     "clean": "shx rm -rf dist",
     "dxt:pack": "dxt pack . && shx mkdir -p dist/dxt && shx mv jasper-mcp-server.dxt dist/dxt/",
     "publish:npm:private": "npm publish",
     "publish:npm:public": "npm publish --access public",
     "remote:dev": "npm run build:remote && dotenv -- npm run start:remote",
     "run:inspector": "npx @modelcontextprotocol/inspector node dist/local/local/index.js",
     "start": "node dist/local/local/index.js",
     "start:remote": "node dist/remote/remote/index.js",
     "test": "echo \"Error: no test specified\" && exit 1",
     "test:ci": "echo \"Error: no test specified\" && exit 0",
     "type-check": "tsc --noEmit"
    },
    "type": "module",
    "types": "./dist/local/local/index.d.ts",
