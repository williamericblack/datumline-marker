     "Other"
    ],
    "contributes": {
     "configuration": {
      "properties": {
       "postgresMcp.keyHost": {
        "default": "",
        "description": "Name of the .env variable that holds the database host. Leave empty to use the default: DB_HOST. (Sets MCP_KEY_HOST)",
        "type": "string"
       },
       "postgresMcp.keyName": {
        "default": "",
        "description": "Name of the .env variable that holds the database name. Leave empty to use the default: DB_NAME. (Sets MCP_KEY_NAME)",
        "type": "string"
       },
       "postgresMcp.keyPass": {
        "default": "",
        "description": "Name of the .env variable that holds the database password. Leave empty to use the default: DB_PASS. (Sets MCP_KEY_PASS)",
        "type": "string"
       },
       "postgresMcp.keyPort": {
        "default": "",
        "description": "Name of the .env variable that holds the database port. Leave empty to use the default: DB_PORT. (Sets MCP_KEY_PORT)",
        "type": "string"
       },
       "postgresMcp.keySslMode": {
        "default": "",
        "description": "Name of the .env variable that holds the SSL mode (e.g. require). Leave empty to use the default: DB_SSLMODE. (Sets MCP_KEY_SSLMODE)",
        "type": "string"
       },
       "postgresMcp.keyUrl": {
        "default": "",
        "description": "Name of the .env variable that holds a full connection URL (e.g. postgresql://user:pass@host:port/db). Leave empty to use the default: DATABASE_URL. When set, individual host/port/user/pass keys are ignored. (Sets MCP_KEY_URL)",
        "type": "string"
       },
       "postgresMcp.keyUser": {
        "default": "",
        "description": "Name of the .env variable that holds the database user. Leave empty to use the default: DB_USER. (Sets MCP_KEY_USER)",
        "type": "string"
       }
      },
      "title": "Postgres MCP"
     },
     "mcpServerDefinitionProviders": [
      {
       "id": "postgres-mcp",
       "label": "Postgres MCP"
      }
     ]
    },
