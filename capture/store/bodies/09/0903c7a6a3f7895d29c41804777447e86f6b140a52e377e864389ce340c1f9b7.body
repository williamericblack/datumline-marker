    "scripts": {
     "bench:agent-run": "bun run scripts/bench/agent-run.ts",
     "bench:questions": "bun run scripts/bench/generate-questions.ts",
     "bench:scramble": "bun run scripts/bench/scramble.ts",
     "bench:serve": "bun run scripts/bench/serve.ts",
     "bench:size": "bun run scripts/bench/size.ts",
     "build": "bun build src/index.ts --outdir build --target node",
     "dev": "bun --watch src/index.ts",
     "dev:http": "bun --watch src/index.ts --mode streamable-http",
     "docker:build": "docker build -t ghcr.io/cedricziel/aha-mcp .",
