    "scripts": {
     "build": "bun build src/index.ts --outdir build --target node --external sqlite3 --external sqlite-vec && cp src/core/database/schema.sql build/",
     "build:http": "bun build src/server/http-server.ts --outdir build --target node --external sqlite3 --external sqlite-vec && cp src/core/database/schema.sql build/",
     "dev": "bun --watch src/index.ts",
