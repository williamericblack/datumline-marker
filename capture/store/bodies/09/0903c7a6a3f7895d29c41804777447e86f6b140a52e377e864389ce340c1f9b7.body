     "tarball": "https://registry.npmjs.org/@cedricziel/aha-mcp/-/aha-mcp-0.1.1.tgz",
     "unpackedSize": 2810667
    },
    "gitHead": "1bfc125f5813a666d661b3f7b5882ee3ca8624e1",
    "homepage": "https://github.com/cedricziel/aha-mcp#readme",
