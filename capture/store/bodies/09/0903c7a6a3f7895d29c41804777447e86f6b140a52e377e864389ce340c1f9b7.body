     "shasum": "1857f2c9c4718d07128d6b2e15157a6d2cd97baa",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEUCIFFZ6CS4yRFm0WoUDB9U8aiYVL4AsYTOKJCUsct2S40lAiEAmtdI37mZavvJJyulDSjNDKE/Ay3CU0wM8GMGbC206TM="
