  "description": "MCP server for DOCX document editing \u2014 read, edit, format, comment, highlight, and track changes in Word documents",
  "dist-tags": {
   "latest": "3.1.0"
  },
  "homepage": "https://github.com/knorq-ai/docx-mcp-server#readme",
