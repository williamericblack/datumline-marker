  },
  "homepage": "https://github.com/LamaSu/federated-workflow-runtime#readme",
  "keywords": [
   "chorus",
   "chorus-integration",
   "workflow",
   "mcp",
   "model-context-protocol",
   "proxy",
   "integration",
   "n8n-alternative"
  ],
