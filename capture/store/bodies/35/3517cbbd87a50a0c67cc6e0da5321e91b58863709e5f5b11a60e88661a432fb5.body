     "start": "node dist/cli.js",
     "test": "vitest run",
     "test:coverage": "vitest run --coverage",
     "test:integration": "vitest run --config vitest.integration.config.ts",
     "test:watch": "vitest"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.3.3"
   },
