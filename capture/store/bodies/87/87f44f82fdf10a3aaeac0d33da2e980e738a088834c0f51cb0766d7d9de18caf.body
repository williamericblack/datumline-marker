     "test:streamable:stateless:client": "tsx testfiles/streamable-http-stateless-test-client.ts",
     "test:streamable:stateless:server": "tsx testfiles/streamable-http-stateless-test-server.ts",
     "test:watch": "vitest",
     "watch": "tsc --watch"
