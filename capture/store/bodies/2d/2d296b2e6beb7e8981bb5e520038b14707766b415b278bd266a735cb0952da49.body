    "scripts": {
     "//test:e2e": "TEMPORARY, AI-GENERATED, NOT HUMAN-MAINTAINED: v1 behavior pin for #1128. Delete with tests/e2e/. Never add to CI.",
     "//test:e2e:remote": "Same case table against a deployed server. Bills real Actor runs to APIFY_TOKEN.",
     "build": "pnpm run build:core && pnpm run build:web",
     "build:core": "tsc -b src && tsc -b tests/test_kit",
     "build:watch": "tsc -b src -w",
     "build:web": "pnpm --filter @apify/mcp-web-widget run build",
     "check": "pnpm run type-check && pnpm run lint",
     "check:agents": "node scripts/check-agents-links.mjs",
     "check:widgets": "tsx scripts/check_widgets.ts",
     "clean": "tsc -b src --clean && tsc -b tests/test_kit --clean && rm -rf dist/web",
     "dev": "node scripts/dev_standby.js",
     "evals:create-dataset": "tsx evals/create_dataset.ts",
     "evals:mcp-agent": "pnpm run build && tsx evals/mcp_agent/run_mcp_agent_evals.ts",
     "evals:mcp-agent:export-dataset": "tsx evals/mcp_agent/export_dataset.ts",
     "evals:mcp-agent:tasks-fixtures": "tsx evals/mcp_agent/tasks_fixtures.ts",
     "evals:run": "tsx evals/run_evaluation.ts",
     "format": "oxfmt",
     "format:check": "oxfmt --check",
     "inspector:stdio": "npx @modelcontextprotocol/inspector -e APIFY_TOKEN=$APIFY_TOKEN -- node dist/stdio.js",
     "lint": "oxlint .",
     "lint:fix": "oxlint . --fix",
     "postbuild": "mkdir -p dist/web && (cp -r src/web/dist dist/web/ 2>/dev/null || :)",
     "start": "tsx src/dev_server.ts",
     "test": "pnpm run test:unit",
     "test:conformance": "bash scripts/test_conformance.sh",
     "test:e2e": "pnpm run build && vitest run --project e2e",
     "test:e2e:remote": "E2E_HTTP_ONLY=1 E2E_HTTP_BASE=${E2E_HTTP_BASE:-https://mcp.apify.com/} vitest run --project e2e",
     "test:integration": "pnpm run build && vitest run tests/integration",
     "test:integration:stateless": "pnpm run build && vitest run tests/integration/actor.server_stateless.test.ts",
     "test:integration:stdio": "pnpm run build && vitest run tests/integration/stdio.test.ts",
     "test:integration:streamable": "pnpm run build && vitest run tests/integration/actor.server_streamable.test.ts",
     "test:unit": "vitest run tests/unit",
     "type-check": "tsc -p tsconfig.json --noEmit",
     "typecheck": "pnpm run type-check"
