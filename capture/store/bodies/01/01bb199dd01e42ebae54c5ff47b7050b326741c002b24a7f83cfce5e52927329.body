     "shasum": "d7bdee3ff12403f9becd0bae8a11b0181b0c3094",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEYCIQC6iV1QVqGjEqgyLATld8SeJueB3A1+ORuuCNgaTGEhzQIhAOMAR8XfN6qpRYrLsMuWBKs0sXCGfMc8xddyCO7ZP3CI"
