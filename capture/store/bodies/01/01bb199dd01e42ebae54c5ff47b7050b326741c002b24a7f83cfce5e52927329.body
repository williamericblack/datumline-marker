     "integrity": "sha512-ujz3NjdKUlXOa/jYDnbdRw8PnDTMBmYOz11yQQtbj5gdxSev86CMRC7pXxVRWschqnwT+ViHGyvGvPGE2uAyGQ==",
     "shasum": "7c79c7268fdb9ab64d025658b42520c1b849dc56",
     "signatures": [
      {
       "keyid": "SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U",
       "sig": "MEQCICa9kzWnMShNByKys6kLXoy79Z8z8X0FE7wS4gOY0PFpAiBHK5xBE9HbQGuIymGJa+XpzxeTGxdMUQMd0dGC0M1L1w=="
