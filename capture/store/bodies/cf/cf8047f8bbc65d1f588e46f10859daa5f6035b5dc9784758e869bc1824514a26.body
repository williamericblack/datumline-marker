  },
  "description": "Servidor MCP (Model Context Protocol) para a API p\u00fablica do Comando1 \u2014 opere seu ERP por linguagem natural.",
  "dist-tags": {
   "latest": "0.11.1"
  },
  "homepage": "https://comando.one",
  "keywords": [
   "mcp",
