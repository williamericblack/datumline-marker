  "_id": "@_davideast/stitch-mcp",
  "_rev": "25-ada58057589c99b960c57d624e6dfedc",
  "author": {
   "name": "David East"
  },
  "description": "Stitch MCP CLI helper. Automates Google Cloud authentication. Generates MCP config for your client. Sets up a proxy server.",
  "dist-tags": {
   "latest": "0.9.0",
   "next": "0.2.1"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "maintainers": [
