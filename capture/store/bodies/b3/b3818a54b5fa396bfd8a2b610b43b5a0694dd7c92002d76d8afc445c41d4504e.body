 "manifest": {
  "_id": "@node-in-layers/mcp-client",
  "_rev": "36-1c19dfafde2ee78ca92b01acf111d61c",
  "description": "An MCP Client Node In Layers Package, generated by the Node In Layers Toolkit.",
  "dist-tags": {
   "latest": "1.8.1"
  },
  "license": "ISC",
  "maintainers": [
