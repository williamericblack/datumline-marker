  "description": "Simple MCP RAG server using @modelcontextprotocol/sdk",
  "dist-tags": {
   "latest": "1.1.1"
  },
  "homepage": "https://github.com/laskar-ksatria/rag-mcp-nodejs#readme",
  "keywords": [
