  "description": "App-runtime MCP server scaffolding for SMRT apps \u2014 `createMcpAppServer` plus transport adapters (SvelteKit today) for exposing a SMRT app's MCP surface over HTTP.",
  "dist-tags": {
   "latest": "0.49.5"
  },
  "homepage": "https://github.com/happyvertical/smrt/tree/main/packages/smrt-app-mcp#readme",
  "keywords": [
   "smrt",
   "mcp",
   "model-context-protocol",
   "sveltekit"
  ],
  "license": "MIT",
  "maintainers": [
