    "name": "@cplace/mcp-server",
    "repository": {
     "type": "git",
     "url": "git+https://github.com/collaborationFactory/cplace-mcp-server.git"
    },
    "scripts": {
     "build": "tsc && npm run copy-plugin-data",
     "clean": "rm -rf dist",
     "copy-plugin-data": "for dir in src/plugins/*/widget-specifications src/plugins/*/app-catalog; do [ -d \"$dir\" ] && mkdir -p \"dist/plugins/$(basename $(dirname \"$dir\"))\" && cp -r \"$dir\" \"dist/plugins/$(basename $(dirname \"$dir\"))/\"; done && cp -f src/plugins/tag-registry.json dist/plugins/ 2>/dev/null || true",
     "format": "prettier --write src/**/*.ts",
     "lint": "eslint src/**/*.ts",
     "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --validate-https --validate-integrity --allowed-hosts cplace.jfrog.io",
     "prepare": "npm run clean && npm run build && husky",
     "start": "node dist/index.js",
     "start:dev": "node dist/index.js --remote",
     "test": "vitest"
    },
    "type": "module",
    "types": "dist/public-api.d.ts",
    "version": "1.11.1"
   },
