    "gitHead": "28629f12381460263c76b539fb1d60bccb988442",
    "homepage": "https://github.com/aashari/mcp-server-atlassian-bitbucket#readme",
    "jest": {
     "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
     ],
     "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/coverage/"
     ],
     "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
     ],
