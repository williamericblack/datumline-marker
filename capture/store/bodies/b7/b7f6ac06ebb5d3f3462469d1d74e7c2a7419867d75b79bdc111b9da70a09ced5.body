 "manifest": {
  "_id": "@daileyos/mcp-server",
  "_rev": "44-8d98cbb74ffee776477328a3cb30a223",
  "description": "Dailey OS MCP server for Claude Code and AI assistants",
  "dist-tags": {
   "latest": "1.21.2"
  },
  "maintainers": [
   {
    "email": "[redacted-email:3a573db7ec32]",
    "name": "daileyos"
   }
