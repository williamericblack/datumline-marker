  },
  "description": "Model Context Protocol (MCP) server for CODESYS automation platform",
  "dist-tags": {
   "latest": "1.1.16"
  },
  "homepage": "https://github.com/johannesPettersson80/codesys-mcp-toolkit#readme",
  "keywords": [
   "codesys",
   "mcp",
   "modelcontextprotocol",
   "plc",
   "automation",
   "programming"
  ],
